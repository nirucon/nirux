#!/usr/bin/python3
# NIRUX standalone Wi-Fi control. Installed root-owned, never run from a user prefix.
"""Validate a narrow command protocol before invoking system network tools.

Passwords are accepted on stdin only. No action scripts, arbitrary executable,
config paths, global sockets, shell, daemon termination or process flags exist
in this protocol. NetworkManager clients use D-Bus instead of this helper.
"""
import os
import re
import shlex
import subprocess
import sys

READ = {"status", "scan", "scan_results", "list_networks", "disconnect", "add_network"}
FIELDS = {"ssid", "psk", "sae_password", "key_mgmt", "scan_ssid"}


def validate_command(parts):
    if not parts:
        raise ValueError("empty command")
    if len(parts) == 1 and parts[0] in READ | {"save_config", "quit"}:
        return
    if (len(parts) == 2 and parts[0] in {"enable_network", "select_network", "remove_network"}
            and re.fullmatch(r"[0-9]{1,8}", parts[1])):
        return
    if (len(parts) == 4 and parts[0] == "set_network"
            and re.fullmatch(r"[0-9]{1,8}", parts[1]) and parts[2] in FIELDS):
        return
    # wpa_cli accepts a space-separated key_mgmt value without quotes.
    if (len(parts) == 5 and parts[:1] == ["set_network"]
            and parts[1].isdigit() and parts[2:] == ["key_mgmt", "WPA-PSK", "SAE"]):
        return
    raise ValueError("unsupported Wi-Fi operation")


def program(name):
    for directory in ("/usr/sbin", "/usr/bin", "/sbin", "/bin"):
        path = directory + "/" + name
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return path
    raise ValueError(name + " is not installed")


def request(args, input_text=None):
    if args[:1] == ["radio"]:
        if len(args) != 2 or args[1] not in ("on", "off"):
            raise ValueError("radio requires on or off")
        return [program("rfkill"), "unblock" if args[1] == "on" else "block", "wlan"], None
    if len(args) < 2 or args[0] != "-i" or not re.fullmatch(r"[A-Za-z0-9_.:-]{1,15}", args[1]):
        raise ValueError("a wireless interface is required")
    if not os.path.isdir("/sys/class/net/" + args[1] + "/wireless"):
        raise ValueError("not a wireless interface")
    command = [program("wpa_cli"), "-i", args[1]]
    if len(args) > 2:
        validate_command(args[2:])
        if args[2] not in READ:
            raise ValueError("mutations require stdin")
        return command + args[2:], None
    if input_text is None or len(input_text.encode()) > 8192:
        raise ValueError("missing or excessive control input")
    lines = input_text.splitlines()
    if not lines or len(lines) > 32 or "\0" in input_text:
        raise ValueError("invalid control input")
    for line in lines:
        validate_command(shlex.split(line))
    return command, input_text


def main():
    try:
        args = sys.argv[1:]
        interactive = len(args) == 2 and args[0] == "-i"
        text = sys.stdin.read(8193) if interactive else None
        command, text = request(args, text)
        result = subprocess.run(command, input=text, text=True, capture_output=True,
                                timeout=15, env={"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"})
        failed = any(line.strip().lstrip("> ").startswith("FAIL") for line in result.stdout.splitlines())
        if result.returncode or failed:
            raise ValueError("Wi-Fi backend rejected the operation")
        # Interactive command echoes may contain secrets. Never forward them.
        sys.stdout.write("OK\n" if interactive else result.stdout)
    except (ValueError, OSError, subprocess.TimeoutExpired):
        print("Wi-Fi control failed: unsupported request, denied backend operation or timeout", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
