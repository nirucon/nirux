browser_verify_archive() {
  [ -f "$1" ] || die "Helium archive is missing: $1"
  case "$HELIUM_SHA256" in
    *[!0-9a-fA-F]*|'') die 'Helium checksum is invalid' ;;
  esac
  [ "${#HELIUM_SHA256}" = 64 ] || die 'Helium checksum is invalid'
  actual=$(sha256sum "$1" | cut -d ' ' -f1)
  [ "$actual" = "$HELIUM_SHA256" ] || \
    die "Helium checksum mismatch; current browser kept"
}
browser_install_archive() {
  archive=$1
  [ -n "${WORK:-}" ] || die 'browser installation requires a working directory'
  browser_verify_archive "$archive"
  unpack=$WORK/helium-unpack
  rm -rf "$unpack"
  mkdir -p "$unpack" || die 'could not create the Helium extraction directory'
  tar -xJf "$archive" -C "$unpack" || die 'could not extract the Helium archive'
  top=$unpack/helium-$HELIUM_VERSION-x86_64_linux
  [ -x "$top/helium" ] || die 'Helium archive is missing the executable'
  load_output=$(LD_TRACE_LOADED_OBJECTS=1 "$top/helium" 2>&1 || :)
  missing_libs=$(printf '%s\n' "$load_output" | awk '/not found/ {print $1}' | sort -u)
  if [ -n "$missing_libs" ]; then
    die "Helium needs missing shared libraries: $(printf '%s' "$missing_libs" | tr '\n' ' ')"
  fi
  reported=$("$top/helium" --version 2>&1) || die 'the extracted Helium executable cannot start'
  case "$reported" in
    *"$HELIUM_VERSION"*) ;;
    *) die "Helium reports an unexpected version: $reported" ;;
  esac
  mkdir -p "$STATE/browsers" || die 'could not create the managed browser directory'
  destination=$STATE/browsers/helium-$HELIUM_VERSION
  staging=$STATE/browsers/.helium-$HELIUM_VERSION.$$
  rm -rf "$staging"
  mv "$top" "$staging" || die 'could not stage the Helium files'
  rm -rf "$destination"
  mv "$staging" "$destination" || die 'could not install the Helium files'
  mkdir -p "$BIN" || die 'could not create the command directory'
  ln -s "$destination" "$STATE/.browser-current.$$" || die 'could not link Helium'
  mv -Tf "$STATE/.browser-current.$$" "$STATE/browser-current" || die 'could not activate Helium'
  ln -s "$STATE/browser-current/helium" "$BIN/.helium.$$" || die 'could not link the Helium command'
  mv -Tf "$BIN/.helium.$$" "$BIN/helium" || die 'could not activate the Helium command'
  for old in "$STATE/browsers"/helium-*; do
    [ ! -d "$old" ] || [ "$old" = "$destination" ] || rm -rf "$old"
  done
  rm -rf "$unpack"
  browser_write_desktop
  say "Installed managed Helium $HELIUM_VERSION"
}
browser_install() {
  [ "${BROWSER_EFFECTIVE:-keep}" = helium ] || return 0
  if external=$(browser_unmanaged); then
    say "Using the existing Helium at $external; NIRUX will not overwrite it."
    return 0
  fi
  if browser_managed; then
    installed=$(browser_installed_version || :)
    if [ "$installed" = "$HELIUM_VERSION" ]; then
      browser_write_desktop
      say "Managed Helium $HELIUM_VERSION is already installed"
      return 0
    fi
  fi
