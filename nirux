#!/bin/sh
# NIRUX: install a complete X11 desktop, or maintain an existing installation.
set -eu

VERSION=0.10.45
PREFIX=${NIRUX_PREFIX:-$HOME/.local}
BIN=$PREFIX/bin
STATE=$PREFIX/share/nirux
CONFDIR=${XDG_CONFIG_HOME:-$HOME/.config}/niruwm
ROOT=${NIRUX_SYSTEM_ROOT:-}
PROGRAMS="niruwm niructl niruidle nirubar niruscreensaver nirulock nirulauncher nirunotify niruwm-session nirux"
WORK=
LOCKED=0
CONFIG_TMP=
CONFIG_CANDIDATE=
APPLY_PROTOCOL=0
APPLY_OK=0
# Pinned upstream release. The archive is verified before extraction, and the
# extracted browser is still checked for shared libraries and its reported
# version before the stable link is switched.
HELIUM_VERSION=0.19.4.1
HELIUM_SHA256=6ca6e4a00fef5916821fb1af8a9607cc6b386f678a7eb422e55f19116ba30469
BROWSER_CHOICE=
BROWSER_EFFECTIVE=keep
BROWSER_EXPLICIT=0

say() { printf '%s\n' "$*"; }
die() { say "nirux: $*" >&2; exit 1; }
usage() {
  say "NIRUX $VERSION"
  say "Usage: nirux install [--minimal|--no-packages] [--display-manager auto|startx|sddm|lightdm]"
  say "                    [--browser helium|none|keep]"
  say "       nirux update [--no-packages] [--release VERSION] [--browser helium|none|keep]"
  say "       nirux rollback | status | doctor | uninstall [--purge] | --version | --help"
  say "Default: keep an existing display manager; otherwise offer startx (default), SDDM or LightDM."
  say "Browser: a fresh install offers Helium (default Helium) and remembers the choice."
  say "         --browser none is a persistent opt-out; --browser keep preserves the current policy."
  say "--minimal/--no-packages: binaries and integration only; required OS packages must already exist."
  say "Updates check and install missing runtime packages from the downloaded release unless --no-packages is given."
}
cleanup() {
  [ -z "$CONFIG_TMP" ] || rm -f "$CONFIG_TMP"
  [ -z "$CONFIG_CANDIDATE" ] || rm -f "$CONFIG_CANDIDATE"
  [ -z "$WORK" ] || rm -rf "$WORK"
  [ "$LOCKED" = 0 ] || rmdir "$STATE/.lock" 2>/dev/null || :
}
lock() {
  mkdir -p "$STATE"
  mkdir "$STATE/.lock" 2>/dev/null || die "another operation is running ($STATE/.lock)"
  LOCKED=1
  WORK=$(mktemp -d "$STATE/.work.XXXXXX")
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM HUP
}
distro() {
  if [ -r /etc/os-release ]; then
    os_id=$(. /etc/os-release; printf '%s' "${ID:-}")
    case "$os_id" in void|arch|debian) say "$os_id"; return ;; esac
  fi
  if [ -f /etc/void-release ] || command -v xbps-install >/dev/null 2>&1; then say void
  elif [ -f /etc/arch-release ]; then say arch
  elif [ -f /etc/debian_version ]; then say debian
  else die "supported distributions: Void, Arch and Debian"
  fi
}
platform() {
  [ "$(uname -m)" = x86_64 ] || die "release binaries currently support x86_64 only"
  getconf GNU_LIBC_VERSION >/dev/null 2>&1 || die "release binaries require glibc; Void musl is not supported yet"
}
as_root() {
  # Integration tests exercise the target-apply subprocess against a temporary
  # system root. Production never sets this variable.
  if [ "${NIRUX_TEST_AS_ROOT:-0}" = 1 ]; then "$@"; return; fi
  if [ "$(id -u)" = 0 ]; then "$@"; return; fi
  command -v sudo >/dev/null 2>&1 || die "install sudo and grant this user access, then retry"
  if ! sudo -n true 2>/dev/null; then
    if [ -t 0 ]; then
      sudo -v || return $?
    else
      printf 'Password for sudo: ' >&2
      IFS= read -r password || die "sudo needs a password (use a terminal or pipe one line on stdin)"
      if printf '%s\n' "$password" | sudo -S -p '' -v; then
        unset password
      else
        result=$?
        unset password
        return "$result"
      fi
    fi
  fi
  sudo -n "$@"
}
packages_for() {
  case "$1" in
    arch) say "xorg-server xorg-xinit xorg-xauth xorg-xrandr xorg-xset xorg-xprop xorg-xdpyinfo xorg-xwininfo xorg-xrdb xorg-xsetroot xorg-setxkbmap xf86-input-libinput xkeyboard-config dbus pam pipewire pipewire-audio pipewire-pulse pipewire-alsa wireplumber alsa-utils alsa-ucm-conf rtkit fontconfig ttf-dejavu ttf-jetbrains-mono-nerd kitty fish polkit-gnome rofi dunst picom feh maim slop pcmanfm playerctl libnotify brightnessctl gammastep iproute2 iw xdg-utils procps-ng util-linux" ;;
    debian) say "xserver-xorg xserver-xorg-input-libinput xinit xauth x11-xserver-utils x11-utils x11-xkb-utils xkb-data dbus-x11 dbus-user-session libpam0g pipewire pipewire-pulse pipewire-alsa wireplumber alsa-utils alsa-ucm-conf rtkit fontconfig fonts-dejavu-core fonts-font-awesome fonts-jetbrains-mono kitty fish policykit-1-gnome rofi dunst picom feh maim slop pcmanfm playerctl libnotify-bin brightnessctl gammastep iproute2 iw xdg-utils procps util-linux" ;;
    void) say "xorg-minimal xinit xauth xrandr xset xprop xdpyinfo xwininfo xrdb xsetroot setxkbmap xkeyboard-config dbus elogind pam pam-base pipewire wireplumber alsa-utils alsa-ucm-conf rtkit fontconfig dejavu-fonts-ttf nerd-fonts-symbols-ttf kitty fish-shell polkit-gnome rofi dunst picom feh maim slop pcmanfm playerctl libnotify brightnessctl gammastep iproute2 iw xdg-utils procps-ng util-linux" ;;
  esac
}
# Runtime libraries and extraction tools for the pinned Helium archive. These
# are only provisioned when the persistent browser policy is `helium`.
browser_packages_for() {
  case "$1" in
    arch) say "nss nspr cups gtk3 libxcomposite libxdamage libxfixes libxrandr libxkbcommon mesa alsa-lib xz" ;;
    debian) say "libnss3 libnspr4 libcups2 libgtk-3-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libxkbcommon0 libgbm1 libasound2 xz-utils" ;;
    void) say "nss nspr cups gtk+3 libXcomposite libXdamage libXfixes libXrandr libxkbcommon mesa alsa-lib xz" ;;
  esac
}
browser_packages() {
  case "${BROWSER_EFFECTIVE:-${NIRUX_PROVISION_BROWSER:-keep}}" in
    helium) browser_packages_for "$1" ;;
  esac
}
install_packages() {
  install_only=0
  if [ "$#" -gt 0 ]; then
    # The caller named exactly what is missing. Do not perform a full system
    # upgrade as a side effect of installing a runtime dependency.
    pkgs=$1
    install_only=1
  else
    pkgs="curl ca-certificates $(packages_for "$OS") $(browser_packages "$OS")"
    case "$OS" in
      arch) pkgs="$pkgs mesa" ;;
      debian) pkgs="$pkgs libgl1-mesa-dri" ;;
      void) pkgs="$pkgs mesa-dri" ;;
    esac
    case "$DM" in
      sddm)
        pkgs="$pkgs sddm"
        # Arch's sddm-greeter links Qt5 but the package only recommends the
        # Qt5 QML runtime. Without it the greeter cannot start.
        [ "$OS" = arch ] && pkgs="$pkgs qt5-declarative"
        ;;
      lightdm) pkgs="$pkgs lightdm lightdm-gtk-greeter" ;;
    esac
  fi
  if [ "$install_only" = 1 ]; then
    say "Installing missing $OS packages: $pkgs"
  else
    say "Installing $OS packages: $pkgs"
  fi
  # Package names are fixed above; splitting this list is intentional.
  # shellcheck disable=SC2086
  case "$OS" in
    arch)
      if [ "$install_only" = 1 ]; then
        # Never refresh the sync database without upgrading Arch. Use the
        # current database; if its packages expired, pacman fails and the user
        # can explicitly run pacman -Syu before retrying the update.
        as_root pacman -S --needed --noconfirm $pkgs
      else
        as_root pacman -Syu --needed --noconfirm $pkgs
      fi
      ;;
    debian)
      as_root apt-get update
      as_root env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $pkgs
      ;;
    void)
      if [ "$install_only" = 1 ]; then
        as_root xbps-install -Sy $pkgs
      else
        as_root xbps-install -Suy
        as_root xbps-install -Sy $pkgs
      fi
      ;;
  esac
}

# Is this distribution package installed? Queries are deliberately local: an
# update must not install a package the repository only mentions.
package_present() {
  case "$OS" in
    arch) pacman -Q "$1" >/dev/null 2>&1 ;;
    debian) dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed' ;;
    void) xbps-query "$1" >/dev/null 2>&1 ;;
    *) return 1 ;;
  esac
}

# Print the runtime packages this release needs but the machine lacks.
#
# The list comes from the script doing the update, so an older installed NIRUX
# can provision a dependency introduced by the release it is installing.
missing_packages() {
  for required in curl ca-certificates $(packages_for "$OS") $(browser_packages "$OS"); do
    package_present "$required" || say "$required"
  done
  return 0
}

# Install or check this release's runtime dependencies. Called from the newly
# downloaded script after verification, so updates use the new package list
# instead of the old installed one.
provision_packages() {
  mode=${1:-missing}
  OS=${NIRUX_PROVISION_OS:-$(distro)}
  platform
  DM=${NIRUX_PROVISION_DM:-keep}
  BROWSER_EFFECTIVE=${NIRUX_PROVISION_BROWSER:-keep}
  case "$mode" in
    full)
      if [ "${NIRUX_PACKAGES_DRY_RUN:-0}" = 1 ]; then say "would install: $(packages_for "$OS")"; return; fi
      install_packages
      ;;
    missing)
      missing=$(missing_packages)
      if [ -z "$missing" ]; then say 'OS runtime packages are present'; return; fi
      if [ "${NIRUX_PACKAGES_DRY_RUN:-0}" = 1 ]; then say "would install missing: $missing"; return; fi
      # One argument on purpose: install_packages splits this fixed package
      # list, exactly as it does for the full list.
      # shellcheck disable=SC2086
      install_packages "$missing"
      ;;
    *) die "unknown provisioning mode: $mode" ;;
  esac
}
# Configuration migration deliberately supports a small, explicit TOML subset:
# comments and blank lines, bare or quoted keys, [tables] and [[arrays]], plus
# scalar, string, multiline string, array and inline-table values. Dotted keys,
# duplicate tables/keys and any line that is not a header or assignment stop the
# migration instead of guessing. The original file is only replaced after a
# staged candidate parses in both niruwm and nirubar.
config_scan() {
  awk '
function trim(s) {
  sub(/^[ \t]+/, "", s)
  sub(/[ \t\r]+$/, "", s)
  return s
}
function fail(msg) {
  printf "E\t%d\t%s\n", NR, msg
}
function escaped(s, pos,    n, c) {
  n = 0
  pos--
  while (pos > 0) {
    c = substr(s, pos, 1)
    if (c != "\\") break
    n++
    pos--
  }
  return n % 2
}
function unquote(k,    qc, body, i, c, out) {
  k = trim(k)
  if (k == "") return "\001"
  qc = substr(k, 1, 1)
  if (length(k) >= 2 && (qc == "\"" || qc == "\047") && substr(k, length(k), 1) == qc) {
    body = substr(k, 2, length(k) - 2)
    if (qc == "\047") return body
    out = ""
    for (i = 1; i <= length(body); i++) {
      c = substr(body, i, 1)
      if (c != "\\") { out = out c; continue }
      i++
      if (i > length(body)) return "\001"
      c = substr(body, i, 1)
      if (c == "n") out = out "\n"
      else if (c == "t") out = out "\t"
      else if (c == "r") out = out "\r"
      else if (c == "b") out = out "\b"
      else if (c == "f") out = out "\f"
      else if (c == "\\") out = out "\\"
      else if (c == "\"") out = out "\""
      else return "\001"
    }
    return out
  }
  if (k ~ /^[A-Za-z0-9_-]+$/) return k
  return "\001"
}
function normalize_table(s,    n, i, c, qc, start, seg, out, segs) {
  n = length(s)
  qc = ""
  start = 1
  out = ""
  segs = 0
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (qc != "") {
      if (qc == "\"" && c == "\\") { i++; continue }
      if (c == qc) qc = ""
      continue
    }
    if (c == "\"" || c == "\047") { qc = c; continue }
    if (c == ".") {
      seg = unquote(substr(s, start, i - start))
      if (seg == "\001") return "\001"
      out = out (segs ? "." : "") seg
      segs++
      start = i + 1
    }
  }
  if (qc != "") return "\001"
  seg = unquote(substr(s, start))
  if (seg == "\001") return "\001"
  out = out (segs ? "." : "") seg
  return out
}
function header_end(s, start, aot,    n, i, c, qc) {
  n = length(s)
  qc = ""
  for (i = start; i <= n; i++) {
    c = substr(s, i, 1)
    if (qc != "") {
      if (qc == "\"" && c == "\\") { i++; continue }
      if (c == qc) qc = ""
      continue
    }
    if (c == "\"" || c == "\047") { qc = c; continue }
    if (aot && substr(s, i, 2) == "]]") return i
    if (!aot && c == "]") return i
  }
  return 0
}
function find_equal(s,    n, i, c, qc) {
  n = length(s)
  qc = ""
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (qc != "") {
      if (qc == "\"" && c == "\\") { i++; continue }
      if (c == qc) qc = ""
      continue
    }
    if (c == "\"" || c == "\047") { qc = c; continue }
    if (c == "=") return i
  }
  return 0
}
function scan_value(s,    n, i, c) {
  n = length(s)
  i = 1
  while (i <= n) {
    if (ml != "") {
      if (substr(s, i, 3) == ml && (ml != "\"\"\"" || !escaped(s, i))) {
        ml = ""
        i += 3
        continue
      }
      i++
      continue
    }
    c = substr(s, i, 1)
    if (q != "") {
      if (q == "\"" && c == "\\") { i += 2; continue }
      if (c == q) q = ""
      i++
      continue
    }
    if (c == "\"") {
      if (substr(s, i, 3) == "\"\"\"") { ml = "\"\"\""; i += 3; continue }
      q = "\""
      i++
      continue
    }
    if (c == "\047") {
      if (substr(s, i, 3) == "\047\047\047") { ml = "\047\047\047"; i += 3; continue }
      q = "\047"
      i++
      continue
    }
    if (c == "#") return
    if (c == "[") { ad++; i++; continue }
    if (c == "]") {
      ad--
      if (ad < 0) { fail("unexpected ] in value"); ad = 0 }
      i++
      continue
    }
    if (c == "{") { bd++; i++; continue }
    if (c == "}") {
      bd--
      if (bd < 0) { fail("unexpected } in value"); bd = 0 }
      i++
      continue
    }
    i++
  }
  if (q != "") {
    fail("unterminated string")
    q = ""
  }
}
{
  line = $0
  sub(/\r$/, "", line)
  if (ml != "" || q != "" || ad > 0 || bd > 0) {
    scan_value(line)
    next
  }
  lead = line
  sub(/^[ \t]+/, "", lead)
  if (lead == "" || substr(lead, 1, 1) == "#") next
  if (substr(lead, 1, 1) == "[") {
    aot = 0
    start = 2
    if (substr(lead, 1, 2) == "[[") { aot = 1; start = 3 }
    end = header_end(lead, start, aot)
    if (end == 0) { fail("unterminated table header"); next }
    body = substr(lead, start, end - start)
    rest = trim(substr(lead, end + (aot ? 2 : 1)))
    if (rest != "" && substr(rest, 1, 1) != "#") { fail("unexpected text after table header"); next }
    t = normalize_table(body)
    if (t == "\001" || t == "") { fail("unsupported table name"); next }
    if (aot) {
      aot_count[t]++
      ctx = t
      printf "H\t%d\t%s\taot\n", NR, t
    } else {
      if (seen_table[t]) fail("duplicate table [" t "]")
      seen_table[t] = 1
      ctx = t
      printf "H\t%d\t%s\ttable\n", NR, t
    }
    next
  }
  eq = find_equal(lead)
  if (eq == 0) { fail("unsupported line (expected key = value)"); next }
  key = unquote(substr(lead, 1, eq - 1))
  if (key == "\001" || key == "") { fail("unsupported key"); next }
  kid = ctx SUBSEP key
  if (ctx != "" && aot_count[ctx] > 0) kid = kid SUBSEP aot_count[ctx]
  if (seen_key[kid]) fail("duplicate key " key)
  seen_key[kid] = 1
  printf "K\t%d\t%s\t%s\n", NR, ctx, key
  scan_value(substr(lead, eq + 1))
  next
}
END {
  if (ml != "") fail("unterminated multiline string")
  if (q != "") fail("unterminated string")
  if (ad > 0) fail("unterminated array")
  if (bd > 0) fail("unterminated inline table")
}
  ' "$1"
}

config_errors() {
  config_scan "$1" | awk -F '\t' '
    $1 == "E" { printf "line %s: %s\n", $2, $3; found = 1 }
    END { exit !found }
  '
}

config_has_section() {
  config_scan "$1" | awk -F '\t' -v wanted="$2" '
    $1 == "H" && $3 == wanted && $4 == "table" { found = 1 }
    END { exit !found }
  '
}

config_has_key() {
  config_scan "$1" | awk -F '\t' -v wanted_ctx="$2" -v wanted_key="$3" '
    $1 == "K" && $3 == wanted_ctx && $4 == wanted_key { found = 1 }
    END { exit !found }
  '
}

config_header_line() {
  config_scan "$1" | awk -F '\t' -v wanted="$2" '
    $1 == "H" && $3 == wanted && $4 == "table" { print $2; exit }
  '
}

config_next_header_line() {
  config_scan "$1" | awk -F '\t' -v after="$2" '
    $1 == "H" && $2 > after { print $2; exit }
  '
}

insert_config_line() {
  mig_file=$1
  mig_after=$2
  mig_text=$3
  mig_mode=$(stat -c %a "$mig_file") || die "could not read permissions for $mig_file"
  mig_tmp=$(mktemp "$mig_file.nirux.XXXXXX") || die "could not stage $mig_file"
  CONFIG_TMP=$mig_tmp
  if ! cp -p "$mig_file" "$mig_tmp"; then
    rm -f "$mig_tmp"; CONFIG_TMP=
    die "could not stage $mig_file"
  fi
  if ! chmod u+w "$mig_tmp"; then
    rm -f "$mig_tmp"; CONFIG_TMP=
    die "could not stage $mig_file"
  fi
  if awk -v n="$mig_after" -v text="$mig_text" '
    NR == 1 && n == 0 { print text }
    { print }
    NR == n && n > 0 { print text }
    END { if (NR == 0 && n == 0) print text }
  ' "$mig_file" > "$mig_tmp" &&
     chmod "$mig_mode" "$mig_tmp" &&
     mv -f "$mig_tmp" "$mig_file"; then
    CONFIG_TMP=
  else
    rm -f "$mig_tmp"; CONFIG_TMP=
    die "could not update $mig_file; original kept"
  fi
}

# Create the shared configuration on a fresh install, or append settings a new
# release introduced. Existing values are never rewritten.
add_missing_sections() {
  mig_file=$1
  mig_example=$2
  mig_added=""
  for mig_section in nightlight brightness wallpaper autostart monitors bar; do
    if config_has_section "$mig_file" "$mig_section"; then continue; fi
    mig_block=$(awk -v s="[$mig_section]" '
      $0 == s {found=1; print; next}
      found && /^[[:space:]]*\[/ {exit}
      found {print}
    ' "$mig_example")
    [ -n "$mig_block" ] || continue
    {
      printf '\n# Added by NIRUX; values are defaults.\n'
      printf '%s\n' "$mig_block"
    } >> "$mig_file"
    mig_added="$mig_added $mig_section"
  done
  [ -z "$mig_added" ] || say "Added missing config sections:$mig_added"
}

add_missing_top_key() {
  mig_file=$1
  mig_key=$2
  mig_value=$3
  if config_has_key "$mig_file" "" "$mig_key"; then return 0; fi
  mig_first=$(config_scan "$mig_file" | awk -F '\t' '$1 == "H" { print $2; exit }')
  if [ -n "$mig_first" ]; then
    mig_after=$(awk -v last="$((mig_first - 1))" 'NR <= last && NF { line = NR } END { print line + 0 }' "$mig_file")
  else
    mig_after=$(awk 'NF { line = NR } END { print line + 0 }' "$mig_file")
  fi
  insert_config_line "$mig_file" "$mig_after" "$mig_key = $mig_value"
}

add_missing_key() {
  mig_file=$1
  mig_section=$2
  mig_key=$3
  mig_value=$4
  if config_has_key "$mig_file" "$mig_section" "$mig_key"; then return 0; fi
  mig_header=$(config_header_line "$mig_file" "$mig_section")
  [ -n "$mig_header" ] || return 0
  mig_next=$(config_next_header_line "$mig_file" "$mig_header")
  if [ -n "$mig_next" ]; then
    mig_after=$(awk -v first="$((mig_header + 1))" -v last="$((mig_next - 1))" '
      NR >= first && NR <= last && NF { line = NR }
      END { print line + 0 }
    ' "$mig_file")
  else
    mig_after=$(awk -v first="$((mig_header + 1))" 'NR >= first && NF { line = NR } END { print line + 0 }' "$mig_file")
  fi
  [ "$mig_after" -gt 0 ] || mig_after=$mig_header
  insert_config_line "$mig_file" "$mig_after" "$mig_key = $mig_value"
}

validate_config_candidate() {
  mig_candidate=$1
  if [ -n "${WORK:-}" ]; then
    mig_validator_root=$WORK/config-validate
    rm -rf "$mig_validator_root"
    mkdir -p "$mig_validator_root/niruwm"
  else
    mig_validator_root=$(mktemp -d "${TMPDIR:-/tmp}/nirux-config.XXXXXX") || return 1
    mkdir -p "$mig_validator_root/niruwm"
  fi
  if [ -d "$CONFDIR/themes" ]; then
    ln -s "$CONFDIR/themes" "$mig_validator_root/niruwm/themes" 2>/dev/null || :
  fi
  cp "$mig_candidate" "$mig_validator_root/niruwm/config.toml" || {
    rm -rf "$mig_validator_root"; return 1
  }
  for mig_program in niruwm nirubar; do
    if [ -n "${WORK:-}" ] && [ -x "$WORK/generation/bin/$mig_program" ]; then
      mig_validator=$WORK/generation/bin/$mig_program
    elif [ -x "$BIN/$mig_program" ]; then
      mig_validator=$BIN/$mig_program
    else
      say "cannot validate the configuration: $mig_program is not available"
      rm -rf "$mig_validator_root"
      return 1
    fi
    if ! XDG_CONFIG_HOME="$mig_validator_root" "$mig_validator" --check-config >/dev/null 2>"$mig_validator_root/$mig_program.err"; then
      mig_reason=$(sed -n '1p' "$mig_validator_root/$mig_program.err")
      say "configuration candidate rejected by $mig_program${mig_reason:+: $mig_reason}"
      rm -rf "$mig_validator_root"
      return 1
    fi
  done
  rm -rf "$mig_validator_root"
  return 0
}

appearance_has_old_noir_defaults() {
  awk '
    /^[[:space:]]*\[colors\][[:space:]]*$/ { in_colors = 1; next }
    /^[[:space:]]*\[/ { in_colors = 0 }
    in_colors && /^[[:space:]]*[a-z_]+[[:space:]]*=/ {
      line = $0
      sub(/#.*/, "", line)
      split(line, parts, "=")
      key = parts[1]
      value = parts[2]
      gsub(/[[:space:]"]/, "", key)
      gsub(/[[:space:]"]/, "", value)
      found[key] = tolower(value)
      count++
    }
    END {
      expected["background"]="0f0f10"; expected["surface"]="161618";
      expected["foreground"]="e5e5e5"; expected["muted"]="a8a8a8";
      expected["border"]="2a2a2d"; expected["focus"]="5a5a60";
      expected["accent"]="5a5a60"; expected["selected"]="26262a";
      expected["success"]="8fbf7f"; expected["warning"]="d7b36a";
      expected["error"]="d77a7a"; expected["disabled"]="5a5a5e";
      if (count != 12) exit 1
      for (key in expected) if (found[key] != expected[key]) exit 1
      exit 0
    }
  ' "$1"
}
migrate_appearance_defaults() {
  appearance_file=$1
  [ -f "$appearance_file" ] || return 0
  appearance_has_old_noir_defaults "$appearance_file" || return 0
