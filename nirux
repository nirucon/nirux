# Registration only makes NIRUWM available. Debian's Default Xsession (and
# other desktops on Arch/Void) can otherwise win the first-login selection.
# Only an explicit install selects defaults; keep/update never change them.
setup_dm_session() {
  [ "$operation" = install ] || return 0
  case "$DM" in
    lightdm)
      { say "# NIRUX owner: $PREFIX"; say '[Seat:*]'; say 'user-session=niruwm'; } > "$WORK/lightdm-session.conf"
      write_system "$ROOT/etc/lightdm/lightdm.conf.d/50-nirux-session.conf" "$WORK/lightdm-session.conf"
      ;;
    sddm|keep)
      # `keep` means an existing display manager, which may be SDDM.
      [ "$DM" = sddm ] || [ -d "$ROOT/var/lib/sddm" ] || [ -f "$ROOT/usr/bin/sddm" ] || return 0
      forget_sddm_session
      ;;
  esac
}

# SDDM keeps the last chosen session in its own state file, so a machine that
# used another desktop keeps preselecting it after NIRUX is installed, and a
# machine that has used NIRUX can be left on an old NIRUPI entry. On install
# NIRUX therefore names the NIRUWM session as the remembered one: the login
# screen preselects it, every installed session stays in its list, and a
# session chosen later at the login screen is remembered as usual.
#
# Autologin, the remembered user, the theme and every other setting are left
# exactly as they are. The file lives in /var/lib/sddm, which is not world
# readable; when it cannot be read the choice is simply not changed, and the
# session list offered by SDDM is unaffected either way.
sddm_session_entry() {
  # SDDM finds a session by its path under /usr/share (the root prefix is a
  # test-only redirect), and a plain file name works too.
  if [ -f "$ROOT/usr/share/xsessions/niruwm.desktop" ]; then
    say /usr/share/xsessions/niruwm.desktop
  else
    say niruwm.desktop
  fi
}
forget_sddm_session() {
  sddm_state=$ROOT/var/lib/sddm/state.conf
  as_root test -f "$sddm_state" || return 0
  sddm_wanted=$(sddm_session_entry)
  sddm_text=
  if as_root test -s "$sddm_state"; then
    sddm_text=$(as_root cat "$sddm_state" 2>/dev/null) || sddm_text=read-failed
  fi
  if [ "$sddm_text" = read-failed ]; then
    say 'SDDM state is not readable; its session choice was left unchanged'
    return 0
  fi
  printf '%s\n' "$sddm_text" > "$WORK/sddm-state.original"
  sddm_remembered=$(awk '
    /^[[:space:]]*\[/ { last = ($0 ~ /^[[:space:]]*\[Last\][[:space:]]*$/) }
    last && /^[[:space:]]*Session[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*/, ""); print; exit
    }
  ' "$WORK/sddm-state.original")
  # SDDM writes a trailing space after the path.
  while [ "${sddm_remembered% }" != "$sddm_remembered" ]; do sddm_remembered=${sddm_remembered% }; done
  # An unreadable file was skipped above; an empty one carries no text, so it
  # still gets the [Last] section below.
  if [ "$sddm_text" != read-failed ] && [ "${sddm_remembered##*/}" = "${sddm_wanted##*/}" ]; then
    say 'SDDM already preselects NIRUWM'
    return 0
  fi
  # Autologin is configured in SDDM's own main configuration, not in the
  # state file. When it is on, a remembered session is not what starts the
  # machine, and the user's setup is left exactly as it is.
  sddm_autologin=0
  for sddm_conf in "$ROOT/etc/sddm.conf" "$ROOT"/etc/sddm.conf.d/*.conf; do
    [ -f "$sddm_conf" ] || continue
    if as_root grep -q '^[[:space:]]*User[[:space:]]*=[[:space:]]*[^[:space:]]' \
        "$sddm_conf" 2>/dev/null; then
      sddm_autologin=1
    fi
  done
  if [ "$sddm_autologin" = 1 ]; then
    say 'SDDM autologin is configured; its remembered session was left unchanged'
    return 0
  fi
  # The remembered session is replaced in place under [Last]. A file with no
  # [Last] section gets one first, and everything else is kept byte for byte.
  awk -v wanted="$sddm_wanted" '
    /^[[:space:]]*\[Last\][[:space:]]*$/ { inlast = 1; seen = 1; print; if (!placed) { print "Session=" wanted; placed = 1 }; next }
    /^[[:space:]]*\[/ { inlast = 0; print; next }
    inlast && /^[[:space:]]*Session[[:space:]]*=/ { next }
    { print }
    END {
      if (!seen) { print ""; print "[Last]"; print "Session=" wanted }
      else if (!placed) { print "Session=" wanted }
    }
  ' "$WORK/sddm-state.original" > "$WORK/sddm-state" || return 0
  # What was written is read back before it replaces the real file: a mistake
  # here would stop the login screen from starting.
  [ "$(awk -F= '
    /^[[:space:]]*\[/ { inlast = ($0 ~ /^[[:space:]]*\[Last\][[:space:]]*$/) }
    inlast && /^[[:space:]]*Session[[:space:]]*=/ { gsub(/[[:space:]]+$/, "", $2); print $2 }
  ' "$WORK/sddm-state" | head -n 1)" = "$sddm_wanted" ] || \
    die 'could not prepare the SDDM session choice; nothing was changed'
  sddm_mode=644
  sddm_owner=$(as_root stat -c %u:%g "$sddm_state" 2>/dev/null || :)
  as_root cp -p "$sddm_state" "$sddm_state.nirux-backup" 2>/dev/null || :
  as_root install -m "$sddm_mode" "$WORK/sddm-state" "$sddm_state" || return 0
  [ -z "$sddm_owner" ] || as_root chown "$sddm_owner" "$sddm_state" 2>/dev/null || :
  if [ -n "$sddm_remembered" ]; then
    say "SDDM now preselects NIRUWM (was ${sddm_remembered##*/}); every session stays in its list"
  else
    say 'SDDM now preselects NIRUWM; every session stays in its list'
  fi
}

setup_startx() {
  # Never replace a valid user's xinitrc. A legacy NIRUPI/dwm file is known to
  # point at a session that this suite no longer installs, so it is backed up
  # and replaced; an arbitrary custom xinitrc is still preserved.
  legacy=0
  if [ -f "$HOME/.xinitrc" ] && ! owned "$HOME/.xinitrc"; then
    if grep -Eqi 'nirupi|dwm-session|dwm-status|exec[^#]*/dwm' "$HOME/.xinitrc"; then
      legacy=1
    fi
  fi
  if { [ ! -e "$HOME/.xinitrc" ] && [ ! -L "$HOME/.xinitrc" ]; } ||
     { [ -f "$HOME/.xinitrc" ] && owned "$HOME/.xinitrc"; } ||
     [ "$legacy" = 1 ]; then
    if [ "$legacy" = 1 ]; then
      [ -e "$HOME/.xinitrc.nirux-backup" ] || cp -p "$HOME/.xinitrc" "$HOME/.xinitrc.nirux-backup"
      say "Replaced legacy NIRUPI/dwm ~/.xinitrc; backup: $HOME/.xinitrc.nirux-backup"
    fi
    { say '#!/bin/sh'; say "# NIRUX owner: $PREFIX"; say "exec \"$BIN/niruwm-session\""; } > "$WORK/xinitrc"
    install -m 755 "$WORK/xinitrc" "$HOME/.xinitrc"
  fi
  say "From a local TTY: startx $BIN/niruwm-session"
  say "If ~/.xinitrc selects NIRU, plain startx works too. Existing custom ~/.xinitrc files are preserved."
}

# Start a selected display manager only after the session entry and the active
# generation exist. Package installation must never start it early.
start_selected_dm() {
  [ "$operation" = install ] || return 0
  case "$DM" in sddm|lightdm) ;; *) return 0 ;; esac
  if [ "$OS" = void ]; then
    # Linking into runsvdir starts the service immediately, unlike systemctl
    # enable. Do this after activate, never while the generation is staged.
    [ -d "$ROOT/etc/sv/$DM" ] || die "missing runit service for $DM"
    [ -e "$ROOT/var/service/$DM" ] || [ -L "$ROOT/var/service/$DM" ] ||
      as_root ln -s "/etc/sv/$DM" "$ROOT/var/service/$DM"
    return 0
  fi
  case "$OS" in arch|debian) ;; *) return 0 ;; esac
  if ! as_root systemctl is-active --quiet "$DM.service" 2>/dev/null; then
    as_root systemctl start "$DM.service" >/dev/null 2>&1 ||
      say "Could not start $DM; reboot to use it"
  fi
}

ensure_user_dirs() {
  # Use the user's existing XDG choices. On a fresh home, let xdg-user-dirs
  # create the locale-appropriate standard folders; never invent English aliases.
  [ -z "$ROOT" ] || return 0
  [ "${NIRUX_TEST_AS_ROOT:-0}" = 1 ] && return 0
  [ "$(id -u)" = 0 ] && return 0
  command -v xdg-user-dirs-update >/dev/null 2>&1 || return 0
  config_home=${XDG_CONFIG_HOME:-$HOME/.config}
  if [ ! -f "$config_home/user-dirs.dirs" ]; then
    xdg-user-dirs-update >/dev/null 2>&1 || {
      say 'xdg-user-dirs-update failed; standard folders were not created'
      return 0
    }
  fi
  for role in DESKTOP DOCUMENTS DOWNLOAD MUSIC PICTURES VIDEOS; do
    dir=$(xdg-user-dir "$role" 2>/dev/null || :)
    [ -n "$dir" ] && [ "$dir" != "$HOME" ] || continue
    case "$role" in DESKTOP|TEMPLATES|PUBLICSHARE) continue ;; esac
    [ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || say "Could not create $dir"
  done
  # The NIRU desktop does not use a desktop folder, templates or a public
  # share by default. Disable those only when they are still the XDG defaults;
  # a custom path or a non-empty directory is left alone.
  for role in DESKTOP TEMPLATES PUBLICSHARE; do
    dir=$(xdg-user-dir "$role" 2>/dev/null || :)
    [ -n "$dir" ] && [ "$dir" != "$HOME" ] || continue
    case "$role:$dir" in
      DESKTOP:"$HOME/Desktop"|TEMPLATES:"$HOME/Templates"|PUBLICSHARE:"$HOME/Public") ;;
      *) continue ;;
    esac
    if xdg-user-dirs-update --set "$role" "$HOME" >/dev/null 2>&1; then
      if [ -d "$dir" ] && [ -z "$(ls -A "$dir" 2>/dev/null || :)" ]; then
        rmdir "$dir" 2>/dev/null || :
      fi
      say "Disabled unused XDG $role folder (set to \$HOME)."
    fi
  done
}

install_backlight_rule() {
  rule=$ROOT/etc/udev/rules.d/70-nirux-backlight.rules
  { say "# NIRUX owner: $PREFIX"; say 'SUBSYSTEM=="backlight", ACTION=="add|change", RUN+="/bin/chgrp video /sys/class/backlight/%k/brightness", RUN+="/bin/chmod 0660 /sys/class/backlight/%k/brightness"'; } > "$WORK/backlight.rules"
  write_system "$rule" "$WORK/backlight.rules"
  as_root udevadm control --reload-rules >/dev/null 2>&1 || :
  as_root udevadm trigger --subsystem-match=backlight --action=change >/dev/null 2>&1 || :
}

ensure_video_group() {
  # brightnessctl's udev rule grants the video group write access to the
  # backlight. The install user already has sudo, so this does not add a new
  # privilege boundary. Never touch host groups in isolated tests or chroots.
  [ -z "$ROOT" ] || return 0
  [ "${NIRUX_TEST_AS_ROOT:-0}" = 1 ] && return 0
  getent group video >/dev/null 2>&1 || return 0
  command -v usermod >/dev/null 2>&1 || return 0
  target_user=${SUDO_USER:-$(id -un)}
  [ -n "$target_user" ] && [ "$target_user" != root ] || return 0
  if id -nG "$target_user" 2>/dev/null | tr ' ' '\n' | grep -qx video; then return 0; fi
  as_root usermod -aG video "$target_user" || return 0
  as_root udevadm trigger --subsystem-match=backlight --action=change >/dev/null 2>&1 || :
  say "Added $target_user to the video group for brightness; log out/in to activate it."
}

enable_services() {
  if [ "$OS" = void ]; then
    for service in dbus elogind; do
      if [ -d "$ROOT/etc/sv/$service" ] && [ ! -e "$ROOT/var/service/$service" ]; then
        as_root ln -s "/etc/sv/$service" "$ROOT/var/service/$service"
      fi
    done
    for service in bluetoothd power-profiles-daemon udisks2; do
      if [ -d "$ROOT/etc/sv/$service" ] && [ ! -e "$ROOT/var/service/$service" ]; then
        as_root ln -s "/etc/sv/$service" "$ROOT/var/service/$service"
      fi
    done
  else
    case "$DM" in sddm|lightdm) as_root systemctl enable "$DM.service" ;; esac
    for service in bluetooth.service power-profiles-daemon.service udisks2.service; do
      if [ -f "$ROOT/usr/lib/systemd/system/$service" ] ||
         [ -f "$ROOT/lib/systemd/system/$service" ]; then
        as_root systemctl enable "$service" >/dev/null 2>&1 || :
        as_root systemctl start "$service" >/dev/null 2>&1 || :
      fi
    done
  fi
  ensure_video_group
  install_backlight_rule
}
check_pam() {
  [ -f "$ROOT/etc/pam.d/nirulock" ] || { say 'missing PAM service'; return 1; }
  [ "$(stat -c %a "$ROOT/etc/pam.d/nirulock")" = 644 ] || { say 'incorrect PAM permissions'; return 1; }
  awk '$1 == "auth" {found=1} END {exit !found}' "$ROOT/etc/pam.d/nirulock" || { say 'PAM service has no authentication rules'; return 1; }
  for include in $(awk '$2 == "include" || $2 == "substack" {print $3}' "$ROOT/etc/pam.d/nirulock"); do
    [ -f "$ROOT/etc/pam.d/$include" ] || { say "missing PAM include: $include"; return 1; }
  done
}
browser_status() {
  policy=$(browser_policy)
  case "$policy" in
    none)
      say 'managed browser: Helium disabled by persistent opt-out'
      return 0
      ;;
    helium)
      browser=$(browser_path || :)
      if [ -z "$browser" ] || [ ! -x "$browser" ]; then
        say 'missing managed browser helium'
        return 1
      fi
      browser_version=$("$browser" --version 2>&1) || {
        say "broken managed browser helium: $browser_version"
        return 1
      }
      say "installed managed browser $browser_version"
      if browser_managed; then
        desktop=$(browser_desktop_file)
        if [ -f "$desktop" ] && grep -qF "Exec=\"$BIN/helium\"" "$desktop"; then
          say 'installed Helium desktop entry'
        else
          say 'missing or different Helium desktop entry'
          return 1
        fi
      fi
      return 0
      ;;
  esac
  return 0
}
status() {
  result=0
  say "NIRUX $VERSION ($PREFIX)"
  for program in $PROGRAMS; do
    if [ ! -x "$BIN/$program" ]; then say "missing $program"; result=1; continue; fi
    case "$program" in
      niructl|niruwm-session) say "installed $program" ;;
      *)
        if version_text=$("$BIN/$program" --version 2>&1); then say "installed $version_text"
        else say "broken $program: $version_text"; result=1
        fi ;;
    esac
  done
  if [ -f "$ROOT/usr/share/xsessions/niruwm.desktop" ] && grep -qF "$BIN/niruwm-session" "$ROOT/usr/share/xsessions/niruwm.desktop"; then
    say 'installed display-manager session'
  else say 'missing or different display-manager session'; result=1
  fi
  if check_pam; then say 'PAM includes and permissions OK (password authentication not exercised)'; else result=1; fi
  if [ -f "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules" ] &&
     owned "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules"; then
    say 'installed local power polkit rule'
  else say 'missing local power polkit rule'; result=1; fi
  browser_status || result=1
  if [ -L "$STATE/current" ]; then say "generation: $(readlink "$STATE/current")"; fi
  # Installed and running can differ after an update. Report it without
  # treating a normal "log out to activate" state as a damaged installation.
  current_wm=$(readlink -f "$BIN/niruwm" 2>/dev/null || :)
  running_wm=
  for pid in $(pgrep -u "$(id -u)" -x niruwm 2>/dev/null || :); do
    candidate=$(readlink -f "/proc/$pid/exe" 2>/dev/null || :)
    if [ -n "$candidate" ]; then
      running_wm=$candidate
      break
    fi
  done
  if [ -n "$running_wm" ] && ! component_matches_running "$running_wm" "$current_wm"; then
    say "running WM: old generation; log out and back in to activate the update"
  elif [ -n "$running_wm" ]; then
    say "running WM: current binary"
  fi
  stale_bar=0
  current_bar=$(readlink -f "$BIN/nirubar" 2>/dev/null || :)
  for pid in $(pgrep -u "$(id -u)" -x nirubar 2>/dev/null || :); do
    running_bar=$(readlink -f "/proc/$pid/exe" 2>/dev/null || :)
    if [ -n "$running_bar" ] && ! component_matches_running "$running_bar" "$current_bar"; then
      stale_bar=1
    fi
  done
  if [ "$stale_bar" = 1 ]; then
    say "running bar: old generation; run niructl restart-bar"
  fi
  return "$result"
}
# The programs the user actually selected in the shared configuration.
configured_commands() {
  [ -x "$BIN/niruwm" ] || return 0
  "$BIN/niruwm" --dump-config 2>/dev/null | awk '
    /^(terminal|browser|launcher) = / {
      line = $0
      sub(/^[^=]*= */, "", line)
      gsub(/[]["]/, "", line)
      split(line, items, ",")
      split(items[1], words, " ")
      if (words[1] != "") print words[1]
    }
  ' | sort -u
}

doctor() {
  result=0
  status || result=1
  say "selected prefix: $PREFIX"
  case ":$PATH:" in
    *":$BIN:"*) say "PATH includes selected prefix" ;;
    *) say "PATH does not include selected prefix (the session prepends it)" ;;
  esac
  for tool in startx Xorg xauth dbus-run-session fc-match fish brightnessctl gammastep notify-send; do
    if command -v "$tool" >/dev/null 2>&1; then say "available $tool"; else say "missing $tool"; result=1; fi
  done
  if [ -d /sys/class/backlight ] && [ -n "$(ls -A /sys/class/backlight 2>/dev/null)" ]; then
    if command -v brightnessctl >/dev/null 2>&1 && brightnessctl -m >/dev/null 2>&1; then
      say 'backlight readable through brightnessctl'
    else
      say 'backlight present but brightnessctl cannot read it (check udev/group permissions)'
      result=1
    fi
  else say 'no backlight device (desktop or external display)'
  fi
  for tool in $(configured_commands); do
    if command -v "$tool" >/dev/null 2>&1 || [ -x "$BIN/$tool" ]; then
      say "available configured $tool"
    else
      say "missing configured $tool (selected in config.toml)"
      result=1
    fi
  done
  for tool in dunst picom feh maim slop xclip playerctl wpctl amixer bluetoothctl powerprofilesctl; do
    if command -v "$tool" >/dev/null 2>&1; then say "available optional $tool"; else say "missing optional $tool"; fi
  done
  if [ -n "${DISPLAY:-}" ] && command -v wpctl >/dev/null 2>&1; then
    if wpctl status 2>/dev/null | awk '/Sinks:/{inside=1;next} /Sources:/{inside=0} inside && /\*/{found=1} END{exit !found}'; then
      say 'audio default sink available'
    else
      say 'no default audio sink (PipeWire/WirePlumber)'; result=1
    fi
  fi
  bluez_spa=
  for candidate in /usr/lib/spa-0.2/bluez5/libspa-bluez5.so /usr/lib64/spa-0.2/bluez5/libspa-bluez5.so; do
    [ -f "$candidate" ] && bluez_spa="$candidate" && break
  done
  if [ -n "$bluez_spa" ]; then say "Bluetooth BlueZ SPA available ($bluez_spa)"; else say 'Bluetooth BlueZ SPA missing; install the distribution PipeWire BlueZ package'; result=1; fi
  for pair in 'niruwm --check-config' 'nirubar --check-config' 'niruidle --config' 'niruscreensaver --config' 'nirulock --config' 'nirulauncher --check-config' 'nirunotify --check-config'; do
    set -- $pair
    say "== $pair"
    if [ -x "$BIN/$1" ]; then "$BIN/$1" "$2" || result=1; else result=1; fi
  done
  if [ -n "${DISPLAY:-}" ]; then
    say '== live X session'
    "$BIN/niructl" status || result=1
    for program in niruwm nirubar; do
      if pgrep -u "$(id -u)" -x "$program" >/dev/null; then say "running $program"; else say "not running $program"; result=1; fi
    done
    if command -v xprop >/dev/null 2>&1; then
      wm_id=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | sed -n 's/.*# //p')
      if [ -n "$wm_id" ]; then
        wm_name=$(xprop -id "$wm_id" _NET_WM_NAME 2>/dev/null | sed -n 's/.*= //p')
        say "X WM owner $wm_id ${wm_name:-}"
      else
        say "no X window manager owns _NET_SUPPORTING_WM_CHECK"; result=1
      fi
    fi
    if command -v xwininfo >/dev/null 2>&1; then
      bars=$(xwininfo -root -tree 2>/dev/null | grep -c 'NIRUBAR' || true)
      layouts=$(xprop -root _NIRUWM_MONITORS 2>/dev/null | grep -o '\\n' | wc -l | tr -d ' ')
      say "bar windows: $bars; monitor layouts published: $layouts"
      if [ "$bars" != "$layouts" ]; then say 'bar ownership does not match the published monitors'; result=1; fi
    fi
    if command -v dbus-send >/dev/null 2>&1; then
      owner=$(dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:org.freedesktop.Notifications 2>/dev/null | sed -n 's/.*string "\(.*\)"/\1/p' | head -n1)
      if [ -n "$owner" ]; then say "notifications owned by $owner"; else say 'no notification daemon owns the session bus'; fi
    fi
    if pgrep -u "$(id -u)" -x gammastep >/dev/null; then say 'night-light provider gammastep is running'; else say 'night-light provider gammastep is not running'; fi
    if pgrep -u "$(id -u)" -x niruidle >/dev/null; then say 'idle provider niruidle is running'; else say 'idle provider niruidle is not running'; fi
  else say 'Live session check skipped: DISPLAY is unset (normal over SSH/TTY).'
  fi
  return "$result"
}
remove_system() {
  if [ -f "$1" ] && owned "$1"; then
    if [ -f "$1.nirux-backup" ]; then as_root mv -f "$1.nirux-backup" "$1"
    else as_root rm -f "$1"
    fi
  fi
}
remove_app() {
  app=${1:-}
  [ "$#" = 1 ] || die 'remove needs helium, localsend or opencode'
  case "$app" in
    helium)
      browser_remove_managed
      browser_policy_set none
      say 'Removed managed Helium. External Helium installations were not touched.'
      ;;
    localsend)
      localsend_remove_managed
      app_policy_set localsend no
      say 'Removed managed LocalSend. External installations were not touched.'
      ;;
    opencode)
      opencode_remove_managed
      app_policy_set opencode no
      say 'Removed managed OpenCode. External installations were not touched.'
      ;;
    *) die 'remove needs helium, localsend or opencode' ;;
  esac
}

uninstall() {
  purge=0
  for option in "$@"; do case "$option" in --purge) purge=1 ;; *) die "unknown option: $option" ;; esac; done
  lock
  remove_system "$ROOT/usr/share/xsessions/niruwm.desktop"
  remove_wallpaper_app
  remove_display_app
  remove_theme_selector_app
  remove_system "$ROOT/etc/pam.d/nirulock"
  remove_system "$ROOT/etc/udev/rules.d/70-nirux-backlight.rules"
  remove_greeters
  for program in $PROGRAMS; do
    if [ -L "$BIN/$program" ] && [ "$(readlink "$BIN/$program")" = "$STATE/current/bin/$program" ]; then rm -f "$BIN/$program"; fi
  done
  if [ -f "$HOME/.xinitrc" ] && owned "$HOME/.xinitrc"; then rm -f "$HOME/.xinitrc"; fi
  localsend_remove_managed
  opencode_remove_managed
  browser_remove_managed
  browser_remove_policy
  rm -f "$STATE/localsend-policy" "$STATE/opencode-policy"
  remove_terminal
  if [ "$purge" = 1 ]; then
    remove_owned_wallpapers
    rm -rf "${XDG_CONFIG_HOME:-$HOME/.config}/niruwm" "${XDG_CONFIG_HOME:-$HOME/.config}/niruui" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/nirubar" "${XDG_CONFIG_HOME:-$HOME/.config}/nirulauncher" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/nirunotify" "${XDG_CONFIG_HOME:-$HOME/.config}/nirux" \
      "${XDG_STATE_HOME:-$HOME/.local/state}/niruwm" "${XDG_STATE_HOME:-$HOME/.local/state}/nirulock" \
      "${XDG_STATE_HOME:-$HOME/.local/state}/niruscreensaver" \
      "${XDG_CACHE_HOME:-$HOME/.cache}/nirubar"
  fi
  rm -rf "$STATE/generations"
  rm -f "$STATE/current" "$STATE/previous"
  say 'NIRU removed. OS packages retained. An already running session exits normally on logout.'
}
repair_session() {
  lock
  setup_startx
  forget_sddm_session
  say 'Session repair complete. Log out/in, or run startx from a TTY.'
}

repair_wallpaper() {
  source=$STATE/config.example.toml
  [ -f "$source" ] || source=$(dirname "$0")/config.example.toml
  [ -f "$source" ] || die "config example not found: $source (run nirux update)"
  target=$CONFDIR/config.toml
  [ -f "$target" ] || die "config not found: $target"
  wallpaper_dir=$(config_picture_paths | sed -n '1p')
  theme_dir=$(config_picture_paths | sed -n '2p')
  # shellcheck disable=SC2088 # compare the literal TOML default
  case "$theme_dir" in
    "~/"*) theme_path=$HOME/${theme_dir#~/} ;;
    *) theme_path=$theme_dir ;;
  esac
  backup=$target.nirux-wallpaper-backup
  cp -p "$target" "$backup" || die "could not back up $target"
  tmp=$(mktemp "$(dirname "$target")/.config.toml.wallpaper.XXXXXX") || die 'could not stage config'
  awk -v dir="$wallpaper_dir" -v theme="$theme_dir" '
    /^\[/ { in_wallpaper = ($0 == "[wallpaper]") }
    in_wallpaper && /^dir[[:space:]]*=/ { printf "dir = \"%s\"\n", dir; next }
    in_wallpaper && /^theme_dir[[:space:]]*=/ { printf "theme_dir = \"%s\"\n", theme; next }
    { print }
  ' "$target" > "$tmp" || { rm -f "$tmp"; die 'could not update wallpaper paths'; }
  if ! same_file "$target" "$tmp"; then
    mode=$(stat -c %a "$target") || mode=644
    chmod "$mode" "$tmp" && mv -f "$tmp" "$target" || { rm -f "$tmp"; die 'could not activate wallpaper paths'; }
    say "Updated wallpaper paths for the XDG Pictures directory."
  else
    rm -f "$tmp"
    say 'Wallpaper paths already match the XDG Pictures directory.'
  fi
  find "$theme_path" -maxdepth 1 -name 'nirux-wallpaper-*.png' -print 2>/dev/null | head -3 || :
  say "Backup: $backup"
}

reset_config() {
  source=$STATE/config.example.toml
  if [ ! -f "$source" ] && [ -f "$(dirname "$0")/config.example.toml" ]; then
    source=$(dirname "$0")/config.example.toml
  fi
  [ -f "$source" ] || die "config example not found: $source (run nirux update)"
  target=$CONFDIR/config.toml
  if [ -L "$target" ]; then
    resolved=$(readlink -f "$target" 2>/dev/null || :)
    [ -n "$resolved" ] && [ -f "$resolved" ] || die "$target is a broken symlink"
    target=$resolved
  fi
  mkdir -p "$(dirname "$target")"
  if [ -f "$target" ]; then
    backup=$target.nirux-backup
    cp -p "$target" "$backup" || die "could not back up $target"
    mode=$(stat -c %a "$target") || die "could not read permissions for $target"
  else
    backup=
    mode=644
  fi
  temp=$(mktemp "$(dirname "$target")/.config.toml.nirux.XXXXXX") || die 'could not stage configuration'
  cp "$source" "$temp" && chmod "$mode" "$temp" && mv -f "$temp" "$target" || {
    rm -f "$temp"
    die "could not reset $target; original kept"
  }
  [ -z "$backup" ] || say "Backup: $backup"
  say "Reset $target to the NIRUX example."
  if [ -n "${DISPLAY:-}" ] && "$BIN/niructl" reload; then
    say 'Configuration reloaded.'
  else
    say 'Log out/in or run: niructl reload'
  fi
}

rollback() {
  lock
  [ -L "$STATE/previous" ] || die 'no previous generation'
  previous=$(readlink "$STATE/previous")
  [ -x "$previous/bin/niruwm" ] || die 'previous generation is incomplete'
  current=$(readlink "$STATE/current")
  switch_link current "$previous"
  switch_link previous "$current"
  sync_front_links
  say 'Previous program generation restored. System packages and PAM configuration are not rolled back.'
  say 'Log out and back in to use the restored WM and session.'
}
install_or_update() {
  operation=$1; shift
  packages=1; DM=auto; RELEASE=${NIRUX_RELEASE:-}
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --minimal|--no-packages) packages=0 ;;
      --full) packages=1 ;;
      --display-manager) shift; [ "$#" -gt 0 ] || die 'missing display-manager value'; DM=$1 ;;
      --browser) shift; [ "$#" -gt 0 ] || die 'missing browser value'; BROWSER_CHOICE=$1; BROWSER_EXPLICIT=1 ;;
      --wallpapers) shift; [ "$#" -gt 0 ] || die 'missing wallpapers value'; WALLPAPER_CHOICE=$1 ;;
      --localsend) shift; [ "$#" -gt 0 ] || die 'missing localsend value'; LOCALSEND_CHOICE=$1; LOCALSEND_EXPLICIT=1 ;;
      --opencode) shift; [ "$#" -gt 0 ] || die 'missing opencode value'; OPENCODE_CHOICE=$1; OPENCODE_EXPLICIT=1 ;;
      --icons) shift; [ "$#" -gt 0 ] || die 'missing icons value'; ICONS_CHOICE=$1; ICONS_EXPLICIT=1 ;;
      --release) shift; [ "$#" -gt 0 ] || die 'missing release version'; RELEASE=${1#v} ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  case "${WALLPAPER_CHOICE:-}" in
    ''|all|default) ;;
    *) die 'wallpapers must be all or default' ;;
  esac
  case "$operation" in
    update) say "Updating NIRUX... please hold. Checking packages, releases and components." ;;
    install) say "Installing NIRUX... please hold. Checking packages and releases." ;;
  esac
  OS=$(distro)
  platform
  if [ "$operation" = install ]; then choose_dm; else DM=keep; fi
  choose_browser "$operation"
  choose_optional_apps "$operation"
  icons_choose "$operation"
  lock
  case "$BROWSER_EFFECTIVE" in
    helium|none)
      if [ "$operation" = install ] || [ "$BROWSER_EXPLICIT" = 1 ]; then
        browser_policy_set "$BROWSER_EFFECTIVE"
      fi
      ;;
  esac
  if [ "$BROWSER_EXPLICIT" = 1 ] && [ "$BROWSER_EFFECTIVE" = none ]; then
    browser_remove_managed
  fi
  if [ "$LOCALSEND_EXPLICIT" = 1 ] && [ "$LOCALSEND_EFFECTIVE" = no ]; then
    localsend_remove_managed
  fi
  if [ "$OPENCODE_EXPLICIT" = 1 ] && [ "$OPENCODE_EFFECTIVE" = no ]; then
    opencode_remove_managed
  fi
  # The bootstrap install has to include curl before any release can be
  # downloaded. Updates skip this and let the newly verified release provision
  # its own package list below.
  if [ "$operation" = install ] && [ "$packages" = 1 ]; then install_packages; fi
  stage_release
  # The wallpaper set is a question for this terminal, so the running
  # installer asks it and the staged target carries out the answer. It is asked
  # when the target can read the staged wallpaper files (an install or a
  # rollback to a release that ships them) and the ten themes are incomplete.
  wallpaper_decision=
  if [ "$APPLY_PROTOCOL" = 0 ] || [ "$NIRUX_STAGE_COMPONENTS" = 1 ]; then
    wallpaper_bundle_decision
    wallpaper_decision=$wp_decision
  fi
  if [ "$APPLY_PROTOCOL" = 2 ]; then
    if ! NIRUX_PREFIX=$PREFIX NIRUX_SYSTEM_ROOT=$ROOT NIRUX_STAGE_WORK=$WORK \
      NIRUX_APPLY_RELEASE=$RELEASE NIRUX_APPLY_OS=$OS \
      NIRUX_APPLY_DM=$DM NIRUX_APPLY_BROWSER=$BROWSER_EFFECTIVE \
      NIRUX_APPLY_LOCALSEND=$LOCALSEND_EFFECTIVE NIRUX_APPLY_OPENCODE=$OPENCODE_EFFECTIVE \
      NIRUX_APPLY_OPERATION=$operation NIRUX_APPLY_WALLPAPERS="${wallpaper_decision:-}" \
      NIRUX_APPLY_ICONS="${ICONS_EFFECTIVE:-none}" \
      NIRUX_SUDO_SECRET_FILE=${SUDO_SECRET_FILE:-} \
      sh "$WORK/download/nirux/nirux" _apply 2; then
      die 'target installer apply failed; current installation kept'
    fi
    return 0
  fi
  browser_install
  if [ "$LOCALSEND_EFFECTIVE" = yes ]; then localsend_install; else localsend_remove_managed; fi
  if [ "$OPENCODE_EFFECTIVE" = yes ]; then opencode_install; else opencode_remove_managed; fi
  ensure_user_dirs
  # Configuration and system integration must succeed before switching the
  # active programs. A rejected configuration leaves the old generation intact.
  install_config
  install_wallpapers
  select_wallpaper_bundle
  wallpapers_policy=${wallpaper_decision:-}
  wallpapers_install_bundle
  icons_apply
  install_terminal
  prepare_pam
  install_greeters "$DM"
  # A session with no NIRUX greeter still must not keep a grant from a release
  # that installed one; the helper writes nothing when no greeter is present.
  [ -n "${rule_user:-}" ] || rule_user=${SUDO_USER:-$(id -un)}
  install_wifi_rule
  install_login_wallpaper_rule
  install_wallpaper_app
  install_display_app
  install_theme_selector_app
  register_session
  setup_dm_session
  setup_startx
  enable_services
  activate
  start_selected_dm
  if [ -n "${DISPLAY:-}" ] && "$BIN/niructl" restart-bar; then
    say 'Running bar restarted. Log out/in to activate the new WM, idle daemon and session.'
  else say 'Log out/in to activate all updated programs. In a new NIRU session: niructl restart-bar.'
  fi
  refresh_running_theme
}
main() {
  # The bootstrap keeps the one sudo password in a private file, never in the
  # environment: a program NIRUX starts can read its own environment, and a
  # process listing would show an exported secret. The target installer is
  # passed only the file's location, and any part of an install that runs in a
  # subshell reads the same file, so the password is not lost between steps.
  #
  # The copy is per process: a subshell must not delete the file its caller is
  # still using, so only the process that created it removes it.
  if [ -n "${NIRUX_SUDO_SECRET_FILE:-}" ]; then
    SUDO_SECRET_FILE=$NIRUX_SUDO_SECRET_FILE
    SUDO_SECRET_BORROWED=1
  fi
  if [ -n "${NIRUX_SUDO_PASSWORD:-}" ]; then sudo_secret_keep "$NIRUX_SUDO_PASSWORD"; fi
  unset NIRUX_SUDO_PASSWORD
  # A subshell of an install (or a function inside one) inherits the location,
  # not the password.
  [ -n "$SUDO_SECRET" ] || sudo_secret_file || :
  if [ -n "$SUDO_SECRET" ] && [ "$(id -u)" != 0 ] &&
     ! sudo -n id -u >/dev/null 2>&1; then
    if sudo_refresh; then
      SUDO_ASK_LATER=1
      start_sudo_keepalive
    fi
  fi
  case "${1:-}" in
    install|update) install_or_update "$@" ;;
    _provision) shift; provision_packages "$@" ;;
    _handoff-version) say 1 ;;
    _apply-version) say 2 ;;
    _apply) shift; [ "$#" = 1 ] || die 'apply takes one protocol version'; apply_target_release "$1" ;;
    _stage) shift; [ "$#" = 1 ] || die 'staging takes one protocol version'; stage_target_release "$1" ;;
    remove) shift; [ "$#" = 1 ] || die 'remove needs helium, localsend or opencode'; lock; remove_app "$1" ;;
    uninstall) shift; uninstall "$@" ;;
    rollback) [ "$#" = 1 ] || die 'rollback takes no arguments'; rollback ;;
    login-wallpaper) shift; login_wallpaper "$@" ;;
    wallpapers) shift; wallpapers "$@" ;;
    layout) shift; layout "$@" ;;
    reset-config) [ "$#" = 1 ] || die 'reset-config takes no arguments'; reset_config ;;
    repair-session) [ "$#" = 1 ] || die 'repair-session takes no arguments'; repair_session ;;
    repair-wallpaper) [ "$#" = 1 ] || die 'repair-wallpaper takes no arguments'; repair_wallpaper ;;
    status|doctor) [ "$#" = 1 ] || die "$1 takes no arguments"; "$1" ;;
    --version) say "NIRUX $VERSION" ;;
    --help|help) usage ;;
    '') usage; exit 2 ;;
    *) die "unknown command: $1" ;;
  esac
}
[ "${NIRUX_LIBRARY:-0}" = 1 ] || main "$@"
