app_policy() {
  app=$1
  file=$STATE/$app-policy
  [ -f "$file" ] || { say keep; return 0; }
  value=$(awk -v a="$app" '$1 == a && ($2 == "yes" || $2 == "no") {print $2; exit}' "$file")
  [ -n "$value" ] || value=keep
  say "$value"
}

app_policy_set() {
  app=$1; value=$2
  mkdir -p "$STATE"
  printf '# NIRUX owner: %s\n%s %s\n' "$PREFIX" "$app" "$value" > "$STATE/.$app-policy.$$" || \
    die "could not stage the $app policy"
  mv -f "$STATE/.$app-policy.$$" "$STATE/$app-policy" || \
    die "could not persist the $app policy"
}

choose_one_app() {
  app=$1; label=$2; operation=$3; explicit=$4; choice=$5
  persisted=$(app_policy "$app")
  if [ "$explicit" = 1 ]; then
    effective=$choice
  elif [ "$operation" = install ] && [ "$persisted" = keep ]; then
    if [ -t 0 ]; then
      say "Install $label? This is optional and can be removed later with: nirux remove $app"
      printf 'Install %s [Y/n]: ' "$label"
      IFS= read -r answer || answer=yes
      case "$answer" in [nN]*) effective=no ;; *) effective=yes ;; esac
    else
      effective=yes
    fi
  elif [ "$persisted" = keep ]; then
    effective=yes
  else
    effective=$persisted
  fi
  case "$effective" in yes|no) ;; *) die "$app choice must be yes or no" ;; esac
  if [ "$explicit" = 1 ] || [ "$operation" = install ]; then
    app_policy_set "$app" "$effective"
  fi
}

choose_optional_apps() {
  operation=$1
  choose_one_app localsend LocalSend "$operation" "$LOCALSEND_EXPLICIT" "$LOCALSEND_CHOICE"
  LOCALSEND_EFFECTIVE=$effective
  choose_one_app opencode OpenCode "$operation" "$OPENCODE_EXPLICIT" "$OPENCODE_CHOICE"
  OPENCODE_EFFECTIVE=$effective
}

choose_browser() {
  operation=$1
  persisted=$(browser_policy)
  if [ "$BROWSER_EXPLICIT" = 1 ]; then
    effective=$BROWSER_CHOICE
  elif [ "$operation" = install ]; then
    if [ "$persisted" != keep ]; then
      effective=$persisted
    elif [ -t 0 ]; then
      say 'Install the managed Helium browser? Its runtime dependencies are installed by NIRUX.'
      printf 'Install Helium [Y/n]: '
      IFS= read -r answer || answer=yes
      case "$answer" in [nN]*) effective=none ;; *) effective=helium ;; esac
    else
      effective=helium
    fi
  else
    effective=$persisted
  fi
  case "$effective" in
    helium|none) ;;
    keep)
      # A fresh noninteractive install still needs a usable default. An update
      # with no recorded policy keeps the machine's existing browser untouched.
      [ "$operation" = install ] && effective=helium
      ;;
    *) die 'browser must be helium, none or keep' ;;
  esac
  BROWSER_EFFECTIVE=$effective
}

icons_policy_path() { say "$STATE/icons-policy"; }
icons_policy_read() {
  icons_persisted=$(awk '$1 == "icons" && ($2 == "papirus" || $2 == "none") {print $2; exit}'     "$(icons_policy_path)" 2>/dev/null) || :
}
icons_policy_write() {
  mkdir -p "$STATE" || die 'could not create icon policy directory'
  printf '# NIRUX owner: %s\nicons %s\n' "$PREFIX" "$1" > "$STATE/icons-policy.new" ||
    die 'could not record the icon policy'
