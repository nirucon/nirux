icons_packages_for() {
  case "$1" in
    arch) say "papirus-icon-theme gtk-update-icon-cache gsettings-desktop-schemas" ;;
    debian) say "papirus-icon-theme gtk-update-icon-cache gsettings-desktop-schemas" ;;
    void) say "papirus-icon-theme gtk-update-icon-cache gsettings-desktop-schemas" ;;
  esac
}
set_icon_ini() {
  icon_file=$1
  icon_dir=${icon_file%/*}
  mkdir -p "$icon_dir" || return 1
  if [ -f "$icon_file" ]; then
    icon_tmp=$(mktemp "$icon_file.XXXXXX") || return 1
    awk '$0 !~ /^[[:space:]]*gtk-icon-theme-name[[:space:]]*=/ {print}' "$icon_file" > "$icon_tmp" || {
      rm -f "$icon_tmp"; return 1;
    }
    mv -f "$icon_tmp" "$icon_file" || return 1
  fi
  printf 'gtk-icon-theme-name=Papirus-Dark\n' >> "$icon_file"
}
icons_apply() {
  [ "${ICONS_EFFECTIVE:-none}" = papirus ] || return 0
  icons_packages=$(icons_packages_for "$OS")
  # The package is installed only for this explicit choice; it is deliberately
  # not in the base package list because the theme is large.
  install_packages "$icons_packages" || die 'could not install Papirus icon packages'
  icons_source=$ROOT/usr/share/icons/Papirus-Dark
  [ -d "$icons_source" ] || die 'Papirus-Dark is missing after package installation'
  icons_dest=$HOME/.local/share/icons/Papirus-Dark
  icons_base_source=$ROOT/usr/share/icons/Papirus
  icons_base_dest=$HOME/.local/share/icons/Papirus
  if [ ! -d "$icons_dest" ]; then
    mkdir -p "$HOME/.local/share/icons" || die 'could not create the local icon directory'
    cp -a "$icons_source" "$icons_dest" || die 'could not copy Papirus-Dark locally'
  fi
  if [ -d "$icons_base_source" ] && [ ! -d "$icons_base_dest" ]; then
    mkdir -p "$HOME/.local/share/icons" || die 'could not create the local icon directory'
    cp -a "$icons_base_source" "$icons_base_dest" || die 'could not copy Papirus locally'
  fi
  # The full Papirus folder switcher is not packaged consistently across all
  # three distros. Re-point the ordinary folder symbol to the shipped grey
  # variant in both local themes; this is the part PCManFM uses for folders.
  for icons_theme in "$icons_dest" "$icons_base_dest"; do
    [ -d "$icons_theme" ] || continue
    for icons_folder in "$icons_theme"/*/places/folder.svg; do
      [ -f "${icons_folder%/*}/folder-grey.svg" ] || continue
      ln -sfn folder-grey.svg "$icons_folder" || :
    done
  done
  set_icon_ini "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-3.0/settings.ini" || :
  set_icon_ini "${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini" || :
  if [ -f "$HOME/.gtkrc-2.0" ]; then
    gtk2_tmp=$(mktemp "$HOME/.gtkrc-2.0.XXXXXX") || :
    if [ -n "${gtk2_tmp:-}" ]; then
      awk '$0 !~ /^[[:space:]]*gtk-icon-theme-name[[:space:]]*=/ {print}' "$HOME/.gtkrc-2.0" > "$gtk2_tmp" &&
        mv -f "$gtk2_tmp" "$HOME/.gtkrc-2.0" || rm -f "$gtk2_tmp"
    fi
  fi
  printf 'gtk-icon-theme-name="Papirus-Dark"\n' >> "$HOME/.gtkrc-2.0"
  if command -v dconf >/dev/null 2>&1; then
    dconf write /org/gnome/desktop/interface/icon-theme "'Papirus-Dark'" >/dev/null 2>&1 || :
    dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'" >/dev/null 2>&1 || :
  fi
  command -v gsettings >/dev/null 2>&1 && {
    gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' >/dev/null 2>&1 || :
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' >/dev/null 2>&1 || :
  }
  command -v gtk-update-icon-cache >/dev/null 2>&1 && {
    gtk-update-icon-cache -f -t "$icons_dest" >/dev/null 2>&1 || :
    [ -d "$icons_base_dest" ] && gtk-update-icon-cache -f -t "$icons_base_dest" >/dev/null 2>&1 || :
  }
  icons_policy_write papirus
}
icons_choose() {
  operation=$1
  icons_persisted=
  icons_policy_read
  icons_persisted=$icons_persisted
  if [ "$ICONS_EXPLICIT" = 1 ] && [ "$ICONS_CHOICE" != keep ]; then
    ICONS_EFFECTIVE=$ICONS_CHOICE
  elif [ "$operation" = update ] || [ "$ICONS_CHOICE" = keep ]; then
    ICONS_EFFECTIVE=${icons_persisted:-none}
  elif [ -t 0 ]; then
    say 'Install Papirus-Dark icons with grey folders for this user?'
    say 'This is an optional ~112-190 MB download and a local copy under ~/.local/share/icons.'
    printf 'Install Papirus-Dark [y/N]: '
    IFS= read -r icons_answer || icons_answer=no
    case "$icons_answer" in [yY]*) ICONS_EFFECTIVE=papirus ;; *) ICONS_EFFECTIVE=none ;; esac
  else
    ICONS_EFFECTIVE=none
  fi
  case "$ICONS_EFFECTIVE" in papirus|none) ;; *) die 'icons must be papirus or none' ;; esac
  if [ "$ICONS_EXPLICIT" = 1 ] || [ "$operation" = install ]; then
    icons_policy_write "$ICONS_EFFECTIVE"
  fi
}

# Ask once whether to fetch the optional theme wallpaper set.
#
# Only the default theme's wallpaper ships with a release; the other nine are a
# 326 MB set from the project's server so a GitHub release stays small. The
# question is asked at install only, remembered in a policy file, and defaults
# to no so an unattended install never pulls hundreds of megabytes.
#
# The same set is offered once more when an update finds the other nine themes
# without their wallpapers, so an earlier "no" can still be answered with a
# terminal. `nirux wallpapers download` always stays available.
# The answer lives in $STATE/wallpaper-bundle-policy; see
# wallpaper_bundle_decision below.
wallpapers_policy_read() {
  wp_policy_file=$STATE/wallpaper-bundle-policy
  wp_persisted=$(awk '$1 == "wallpapers" && ($2 == "all" || $2 == "default") {print $2; exit}' \
    "$wp_policy_file" 2>/dev/null) || :
}
# The running installer decides whether to fetch the set. The question belongs
# to the terminal that started the install: the staged target runs with stdin
# closed, so it never sees one, and its answer file is carried over instead.
wallpaper_bundle_decision() {
  # The decision is returned in wp_decision, never on stdout: the caller uses
  # this function interactively, and a command substitution would capture the
  # prompt and leave a blind read waiting for input.
  wp_decision=
  case "${WALLPAPER_CHOICE:-${NIRUX_WALLPAPERS:-}}" in
    all) wp_decision=all; return 0 ;;
    none|default) wp_decision=default; return 0 ;;
  esac
  wallpapers_policy_read
  case "$operation" in
    install)
      # A fresh noninteractive install still gets the full nine-theme set.
      # The owner explicitly wants every installed machine to have all theme
      # wallpapers; an explicit `default` policy or --wallpapers default is
      # the way to opt out.
      if [ -z "$wp_persisted" ] && [ ! -t 0 ]; then
        wp_decision=all
        return 0
      fi
      ;;
    update)
      # Only when the ten themes are known to be incomplete, so a machine that
      # already has the set never asks again.
      [ "$(wallpaper_theme_count)" -lt 10 ] || return 0
      if [ "$wp_persisted" = all ] && [ -f "${WORK}/download/nirux/nirux-wallpapers.tar.xz" ]; then
        wp_decision=all
        return 0
      fi
      ;;
    *) return 0 ;;
  esac
  [ -t 0 ] || return 0
  if [ "$wp_persisted" = all ]; then
    # Asked for once and never delivered, for example because the download
    # failed. Fetch it again when the release ships the files.
    [ -f "${WORK}/download/nirux/nirux-wallpapers.tar.xz" ] && wp_decision=all
    return 0
  fi
  say ''
  say 'NIRUX ships ten themes, and changing theme is the main way to change the look.'
  say 'With every wallpaper installed, a theme change brings its wallpaper, bar palette,'
  say 'terminal colours and login screen together. Without them the nine non-default'
  say 'themes use their own background colour, which works but looks plain.'
  say ''
  say 'The full set is a one-time download of about 280 MB (4k and 8k) from'
  say 'nextcloud.nirucon.se. An update never fetches it again, and you can add it'
  say 'later from the launcher under Wallpaper or with: nirux wallpapers download'
  say ''
  printf 'Download the wallpapers for all ten themes now? [Y/n]: '
  IFS= read -r wp_answer || wp_answer=yes
  # The recommended answer is yes, so an empty line accepts the set. Only an
  # explicit no declines; an unattended install still defaults to the small
  # release because it never reaches this prompt.
  case "$wp_answer" in
    [nN]*) wp_decision=default ;;
    *) wp_decision=all ;;
  esac
}
wallpapers_policy_write() {
  [ -n "${wp_policy_file:-}" ] || wp_policy_file=$STATE/wallpaper-bundle-policy
  printf '# NIRUX owner: %s\nwallpapers %s\n' "$PREFIX" "$wp_persisted" > "$wp_policy_file" ||
    die 'could not record the wallpaper policy'
}
# Direct (non-staged) installs used to call a helper that no longer existed.
# Keep the decision and the persisted policy in one place for both paths.
select_wallpaper_bundle() {
  [ -n "${wallpaper_decision:-}" ] || return 0
  wp_persisted=$wallpaper_decision
  wallpapers_policy_write
}
manifest_version() {
  value=$(awk -v n="$1" '$1 == n {print $2}' "$WORK/download/nirux/manifest")
  valid_version "$value" || die "invalid manifest entry: $1"
  say "$value"
}
component_files() {
  case "$1" in
    niruwm) say "niruwm niructl niruidle niruwm-session" ;;
    *) say "$1" ;;
  esac
}
stage_component_assets() {
  component=$1
  component_version=$2
  case "$component" in
    niruwm) release_files niruwm "$component_version" niruwm niructl niruidle niruwm-session ;;
    nirulock) release_files nirulock "$component_version" nirulock pam-arch pam-debian pam-void ;;
    nirux) : ;;
    *) release_files "$component" "$component_version" "$component" ;;
  esac
}
manifest_components() {
  awk '$1 != "schema" && $1 != "suite" {print $1}' "$WORK/download/nirux/manifest"
}
verify_staged_version() {
  staged_program=$1
  staged_version=$2
  [ -x "$WORK/generation/bin/$staged_program" ] || die "staged $staged_program is missing or not executable"
  staged_reported=$("$WORK/generation/bin/$staged_program" --version | awk '{print $2}')
  [ "$staged_reported" = "$staged_version" ] || die "$staged_program does not report expected version $staged_version"
}
stage_components() {
  stage_suite=$(manifest_version suite)
  # These components are part of the desktop contract even if a future manifest
  # adds more entries.
  for required in niruwm nirubar niruscreensaver nirulock nirulauncher nirunotify; do
    manifest_version "$required" >/dev/null
  done
  mkdir -p "$WORK/generation/bin"
  install -m 755 "$WORK/download/nirux/nirux" "$WORK/generation/bin/nirux"
  # The manifest, not a hardcoded list in the running installer, decides which
  # components this release contains. Unknown components use the convention of
  # one release asset with the component name.
  for component in $(manifest_components); do
    [ "$component" = nirux ] && continue
    component_version=$(manifest_version "$component")
    stage_component_assets "$component" "$component_version"
    for staged_program in $(component_files "$component"); do
      staged_source=$WORK/download/$component/$staged_program
      [ -f "$staged_source" ] || die "release $component $component_version is missing $staged_program"
      install -m 755 "$staged_source" "$WORK/generation/bin/$staged_program"
    done
  done
  cp "$WORK/download/nirux/manifest" "$WORK/generation/manifest"
  [ -f "$WORK/download/nirulock/pam-$OS" ] || die "release nirulock is missing pam-$OS"
  cp "$WORK/download/nirulock/pam-$OS" "$WORK/generation/pam"
  verify_staged_version nirux "$stage_suite"
  # Running --version also catches missing loaders/shared libraries before activation.
  for component in $(manifest_components); do
    [ "$component" = nirux ] && continue
    component_version=$(manifest_version "$component")
    case "$component" in
      niruwm)
        verify_staged_version niruwm "$component_version"
        verify_staged_version niruidle "$component_version"
        ;;
      *) verify_staged_version "$component" "$component_version" ;;
    esac
  done
}
stage_target_release() {
  [ "$1" = 1 ] || die "unsupported staging protocol: $1"
  [ -n "${NIRUX_STAGE_WORK:-}" ] || die 'staging work directory is missing'
  WORK=$NIRUX_STAGE_WORK
  OS=${NIRUX_PROVISION_OS:-$(distro)}
  [ "$(manifest_version schema)" = 1 ] || die "unsupported manifest schema"
  [ "$(manifest_version suite)" = "$VERSION" ] || die "target installer/manifest version mismatch"
  stage_components
}
apply_prepare_backup() {
  mkdir -p "$WORK/apply-backup" || die 'could not create the apply backup directory'
  APPLY_CONFIG_TARGET=$CONFDIR/config.toml
  APPLY_CONFIG_EXISTED=0
  if [ -e "$CONFDIR/config.toml" ] || [ -L "$CONFDIR/config.toml" ]; then
    if [ -L "$CONFDIR/config.toml" ]; then
      APPLY_CONFIG_TARGET=$(readlink -f "$CONFDIR/config.toml" 2>/dev/null || :)
      [ -n "$APPLY_CONFIG_TARGET" ] || die 'the configuration symlink does not resolve'
    fi
    cp -p "$APPLY_CONFIG_TARGET" "$WORK/apply-backup/config.toml" || \
      die 'could not back up the configuration before apply'
    APPLY_CONFIG_EXISTED=1
  fi
  APPLY_APPEARANCE_TARGET=$CONFDIR/appearance.toml
  APPLY_APPEARANCE_EXISTED=0
  if [ -e "$CONFDIR/appearance.toml" ] || [ -L "$CONFDIR/appearance.toml" ]; then
    if [ -L "$CONFDIR/appearance.toml" ]; then
      APPLY_APPEARANCE_TARGET=$(readlink -f "$CONFDIR/appearance.toml" 2>/dev/null || :)
      [ -n "$APPLY_APPEARANCE_TARGET" ] || die 'the appearance symlink does not resolve'
    fi
    cp -p "$APPLY_APPEARANCE_TARGET" "$WORK/apply-backup/appearance.toml" || \
      die 'could not back up the appearance file before apply'
    APPLY_APPEARANCE_EXISTED=1
  fi
}
apply_restore_config() {
  if [ "$APPLY_OK" = 1 ]; then
    rm -rf "$WORK/apply-backup"
    return 0
  fi
  if [ -n "${APPLY_CONFIG_TARGET:-}" ]; then
    if [ "${APPLY_CONFIG_EXISTED:-0}" = 1 ]; then
      cp -p "$WORK/apply-backup/config.toml" "$APPLY_CONFIG_TARGET" 2>/dev/null || :
    else
      rm -f "$APPLY_CONFIG_TARGET" 2>/dev/null || :
    fi
  fi
  if [ -n "${APPLY_APPEARANCE_TARGET:-}" ]; then
    if [ "${APPLY_APPEARANCE_EXISTED:-0}" = 1 ]; then
      cp -p "$WORK/apply-backup/appearance.toml" "$APPLY_APPEARANCE_TARGET" 2>/dev/null || :
    else
      rm -f "$APPLY_APPEARANCE_TARGET" 2>/dev/null || :
    fi
  fi
  rm -rf "$WORK/apply-backup"
  say 'Target apply failed; original configuration restored.' >&2
}
apply_target_release() {
  [ "$1" = 2 ] || die "unsupported apply protocol: $1"
  [ -n "${NIRUX_STAGE_WORK:-}" ] || die 'target apply work directory is missing'
  WORK=$NIRUX_STAGE_WORK
  OS=${NIRUX_APPLY_OS:-$(distro)}
  DM=${NIRUX_APPLY_DM:-keep}
  BROWSER_EFFECTIVE=${NIRUX_APPLY_BROWSER:-keep}
  LOCALSEND_EFFECTIVE=${NIRUX_APPLY_LOCALSEND:-yes}
  OPENCODE_EFFECTIVE=${NIRUX_APPLY_OPENCODE:-yes}
  ICONS_EFFECTIVE=${NIRUX_APPLY_ICONS:-none}
  operation=${NIRUX_APPLY_OPERATION:-update}
  RELEASE=${NIRUX_APPLY_RELEASE:-$(manifest_version suite)}
  [ "$(manifest_version schema)" = 1 ] || die 'unsupported manifest schema'
  [ "$(manifest_version suite)" = "$VERSION" ] || die 'target installer/manifest version mismatch'
  [ "$RELEASE" = "$VERSION" ] || die 'apply release does not match the target installer'
  [ -f "$WORK/generation/manifest" ] || die 'target apply has no staged generation'
  [ "$(awk '$1 == "suite" {print $2}' "$WORK/generation/manifest")" = "$RELEASE" ] || \
    die 'staged generation does not match the apply release'
  # The caller may predate an asset added by this target. The target owns the
  # new asset list and fetches/verifies anything it needs before changing user
  # or system files.
  release_optional_file nirux "$RELEASE" nirux-wallpapers.tar.xz
  release_optional_file nirux "$RELEASE" nirux-terminal.tar.xz
  release_optional_file nirux "$RELEASE" nirux-integration.tar.xz
  release_optional_file nirux "$RELEASE" niruwallpaper.desktop
  release_optional_file nirux "$RELEASE" niruwallpaper.png
  release_optional_file nirux "$RELEASE" nirudisplay.desktop
  release_optional_file nirux "$RELEASE" nirudisplay.png
  release_optional_file nirux "$RELEASE" niruthemeselector.desktop
  release_optional_file nirux "$RELEASE" niruthemeselector.png
  # The wallpaper policy is the running installer's answer. It is validated
  # here before any file changes, even when the target ships no wallpaper
  # files of its own.
  case "${NIRUX_APPLY_WALLPAPERS:-}" in
    ''|default|all) ;;
    *) die "invalid wallpaper choice: $NIRUX_APPLY_WALLPAPERS" ;;
  esac
  # A release without wallpaper files still accepts the policy, so the answer
  # outlives an update that lands between two releases carrying the set.
  wallpapers_policy=${NIRUX_APPLY_WALLPAPERS:-}
  if [ -z "$wallpapers_policy" ]; then
    wallpapers_policy_read
    wallpapers_policy=$wp_persisted
  fi
  [ -n "$wallpapers_policy" ] || wallpapers_policy=keep
  say "Applying NIRUX $RELEASE..."
  apply_prepare_backup
  APPLY_OK=0
  trap 'apply_restore_config' EXIT INT TERM HUP
  browser_install
  if [ "$LOCALSEND_EFFECTIVE" = yes ]; then localsend_install; else localsend_remove_managed; fi
  if [ "$OPENCODE_EFFECTIVE" = yes ]; then opencode_install; else opencode_remove_managed; fi
  ensure_user_dirs
  say 'Installing configuration and desktop assets...'
  install_config
  install_wallpapers
  # Recorded once the assets are in place: a failure before this point leaves
  # the policy file untouched, and the running installer keeps its answer.
  if [ "$wallpapers_policy" != keep ]; then
    wp_persisted=$wallpapers_policy
    wallpapers_policy_write
  fi
  wallpapers_install_bundle
  icons_apply
  install_terminal
  prepare_pam
  install_greeters "$DM"
  # A session with no NIRUX greeter still must not keep a grant from a release
  # that installed one; the helper writes nothing when no greeter is present.
  [ -n "${rule_user:-}" ] || rule_user=${SUDO_USER:-$(id -un)}
  install_wifi_rule
  install_login_wallpaper_rule
  install_wallpaper_app
  install_display_app
  install_theme_selector_app
  register_session
  setup_dm_session
  setup_startx
  say 'Enabling session services...'
  enable_services
  say 'Activating the new program generation...'
  activate
  start_selected_dm
  APPLY_OK=1
  trap - EXIT INT TERM HUP
  rm -rf "$WORK/apply-backup"
  if [ -n "${DISPLAY:-}" ] && "$BIN/niructl" restart-bar; then
    say 'Applied through the target installer. Running bar restarted; log out/in to activate the new WM, idle daemon and session.'
  else say 'Applied through the target installer. Log out/in to activate all updated programs. In a new NIRU session: niructl restart-bar.'
  fi
  refresh_running_theme
}
# Re-apply the active theme after a wallpaper set becomes available. The
# installer may run from a real session (update/manual download), where the
# window manager is already using its earlier colour fallback. A fresh install
# without DISPLAY gets the files before its first session instead.
refresh_running_theme() {
  [ -n "${DISPLAY:-}" ] || return 0
  [ -x "$BIN/niructl" ] || return 0
  "$BIN/niructl" reload >/dev/null 2>&1 || :
}

# The optional theme wallpaper set is downloaded before a fresh session starts,
# so its images are present when NIRUWM first paints the desktop. On an update
# the current session is refreshed after the new generation is activated.
wallpapers_install_bundle() {
  [ "$wallpapers_policy" = all ] || return 0
  wp_install_work=$(mktemp -d "${TMPDIR:-/tmp}/nirux-wallpapers.XXXXXX") || wp_install_work=
  if [ -n "$wp_install_work" ] && WP_WORK=$wp_install_work wallpapers_download; then
    rm -rf "$wp_install_work"
    say 'Theme wallpapers installed.'
  elif [ -n "$wp_install_work" ]; then
    rm -rf "$wp_install_work"
    say 'The theme wallpapers could not be downloaded; the themes keep their background colours.'
    say 'Try again from the launcher under Wallpaper, or: nirux wallpapers download'
  else
    say 'Could not create a temporary directory for the wallpaper download.'
  fi
}
stage_release() {
  if [ -z "$RELEASE" ]; then
    say 'Checking the latest NIRUX release...'
    fetch https://api.github.com/repos/nirucon/nirux/releases/latest "$WORK/latest.json"
    RELEASE=$(sed -n 's/.*"tag_name": *"v\([0-9.]*\)".*/\1/p' "$WORK/latest.json" | head -n 1)
  fi
  say "Preparing NIRUX $RELEASE..."
  release_files nirux "$RELEASE" nirux manifest config.example.toml appearance.example.toml
  release_optional_file nirux "$RELEASE" nirux-wallpapers.tar.xz
  release_optional_file nirux "$RELEASE" nirux-terminal.tar.xz
  release_optional_file nirux "$RELEASE" nirux-integration.tar.xz
  release_optional_file nirux "$RELEASE" niruwallpaper.desktop
  release_optional_file nirux "$RELEASE" niruwallpaper.png
  release_optional_file nirux "$RELEASE" nirudisplay.desktop
  release_optional_file nirux "$RELEASE" nirudisplay.png
  release_optional_file nirux "$RELEASE" niruthemeselector.desktop
  release_optional_file nirux "$RELEASE" niruthemeselector.png
  [ "$(manifest_version schema)" = 1 ] || die "unsupported manifest schema"
  [ "$(manifest_version suite)" = "$RELEASE" ] || die "suite/manifest version mismatch"
  say 'Verifying the downloaded installer and checksums...'
  sh -n "$WORK/download/nirux/nirux"
  reported=$(sh "$WORK/download/nirux/nirux" --version | awk '{print $2}')
  [ "$reported" = "$RELEASE" ] || die 'installer/manifest version mismatch'
  APPLY_PROTOCOL=0
  apply_version=$(sh "$WORK/download/nirux/nirux" _apply-version 2>/dev/null || :)
  if [ "$apply_version" = 2 ]; then APPLY_PROTOCOL=2; fi
  # Packages come from the verified target installer and are provisioned before
  # any staged binary is executed. This lets a new shared-library dependency be
  # present when the new component is first started and version-checked. The
  # staged target resolves renames (Debian trixie's *t64 libraries) from this
  # machine's own package database, so its list is the one installed.
  if [ "$packages" = 1 ]; then
    say 'Checking required OS packages...'
    NIRUX_SYSTEM_ROOT=$ROOT NIRUX_PROVISION_OS=$OS NIRUX_PROVISION_DM=$DM NIRUX_PROVISION_BROWSER=$BROWSER_EFFECTIVE \
      sh "$WORK/download/nirux/nirux" _provision missing
  fi
  # A new target installer stages the release through a versioned handoff, so a
  # newly added component is included on the first update rather than one later.
  handoff=$(sh "$WORK/download/nirux/nirux" _handoff-version 2>/dev/null || :)
  if [ "$handoff" = 1 ]; then
    if ! NIRUX_STAGE_WORK=$WORK NIRUX_PROVISION_OS=$OS \
      sh "$WORK/download/nirux/nirux" _stage 1; then
      die 'target installer staging failed; current installation kept'
    fi
    say 'Staged components. Validating generation...'
    NIRUX_STAGE_COMPONENTS=1
  else
    stage_components
    NIRUX_STAGE_COMPONENTS=0
  fi
  [ -f "$WORK/generation/manifest" ] || die 'target installer produced no staged generation'
  [ "$(awk '$1 == "suite" {print $2}' "$WORK/generation/manifest")" = "$RELEASE" ] || \
    die 'staged generation does not match the requested release'
}
switch_link() {
  ln -s "$2" "$STATE/.$1.$$"
  mv -Tf "$STATE/.$1.$$" "$STATE/$1"
}
sync_front_links() {
  for front in "$BIN"/*; do
    [ -L "$front" ] || continue
    case "$(readlink "$front")" in
      "$STATE/current/bin/"*)
        program=${front##*/}
        [ -e "$STATE/current/bin/$program" ] || rm -f "$front"
        ;;
    esac
  done
}
activate() {
  mkdir -p "$STATE/generations" "$BIN"
  # Adopt a legacy flat installation without changing its active versions.
  if [ ! -L "$STATE/current" ]; then
    legacy=$STATE/generations/legacy-$(date +%s)-$$
    mkdir -p "$legacy/bin"
    for program in $PROGRAMS; do
      [ ! -f "$BIN/$program" ] || cp -pL "$BIN/$program" "$legacy/bin/$program"
    done
    switch_link current "$legacy"
  fi
  old=$(readlink "$STATE/current")
  generation=$STATE/generations/$RELEASE-${WORK##*.}
  mv "$WORK/generation" "$generation"
  # These front links stay constant; current is the single activation point.
  # Use the staged generation rather than this installer's old PROGRAMS list so
  # a component added by the target release is linked on the first update.
  for staged in "$generation/bin"/*; do
    [ -f "$staged" ] || continue
    program=${staged##*/}
    ln -s "$STATE/current/bin/$program" "$BIN/.$program.$$"
    mv -Tf "$BIN/.$program.$$" "$BIN/$program"
  done
  switch_link previous "$old"
  switch_link current "$generation"
  sync_front_links
  say "Activated NIRUX $RELEASE. Previous generation retained for nirux rollback."
}
owned() {
  grep -qxF "# NIRUX owner: $PREFIX" "$1" 2>/dev/null ||
    grep -qxF "// NIRUX owner: $PREFIX" "$1" 2>/dev/null ||
    grep -qxF "/* NIRUX owner: $PREFIX */" "$1" 2>/dev/null
}
# A binary file cannot carry a comment: the header bytes would corrupt it and
# a PNG decoder would reject the icon. Ownership for such files is recorded in
# a sidecar beside the installed file instead, named by its SHA-256. A replaced
# file no longer matches and is therefore not removed.
owned_binary() {
  [ -f "$1" ] || return 1
  [ -f "$own_record" ] || return 1
  current=$(sha256sum "$1" | cut -d ' ' -f1)
  grep -qxF "$current" "$own_record"
}
write_binary() {
  target=$1; source=$2
  own_record=$ROOT$(dirname "$target").nirux-owned/$(basename "$target").sha256
  if [ -f "$target" ]; then
    installed_sum=$(sha256sum "$target" | cut -d ' ' -f1)
    source_sum=$(sha256sum "$source" | cut -d ' ' -f1)
    [ "$installed_sum" != "$source_sum" ] || return 0
    # An unmodified NIRUX icon is replaced; anything else is preserved as a
    # backup first, exactly as write_system does for text files.
    if ! owned_binary "$target"; then
      [ -f "$target.nirux-backup" ] || as_root cp -p "$target" "$target.nirux-backup"
    fi
  fi
  as_root install -d -m 755 "$(dirname "$target")"
  as_root install -m 644 "$source" "$target"
  as_root install -d -m 755 "$(dirname "$own_record")"
  { sha256sum "$source" | cut -d ' ' -f1 | as_root tee "$own_record" >/dev/null; }
}
remove_binary() {
  target=$1
  own_record=$ROOT$(dirname "$target").nirux-owned/$(basename "$target").sha256
  if [ -f "$target" ] && owned_binary "$target"; then
    if [ -f "$target.nirux-backup" ]; then as_root mv -f "$target.nirux-backup" "$target"
    else as_root rm -f "$target"
    fi
  fi
  if [ -f "$own_record" ]; then
    as_root rm -f "$own_record"
    as_root rmdir "$(dirname "$own_record")" 2>/dev/null || :
  fi
}
legacy_owned() {
  case "$1" in
    */xsessions/niruwm.desktop)
      grep -qxF "Exec=$BIN/niruwm-session" "$1" ||
        grep -qxF "Exec=\"$BIN/niruwm-session\"" "$1" ;;
    */pam.d/nirulock) grep -q '^# Installed by nirux\.' "$1" 2>/dev/null ;;
    *) return 1 ;;
  esac
}
# Are two files identical? `cmp` is not installed by default on every
# distribution NIRUX supports (Arch's coreutils leaves it out), so the check
# falls back to comparing the bytes with the shell tools that are always there.
same_file() {
  if command -v cmp >/dev/null 2>&1; then
    cmp -s "$1" "$2"
  else
    [ "$(sha256sum "$1" | cut -d ' ' -f1)" = "$(sha256sum "$2" | cut -d ' ' -f1)" ]
  fi
}
write_system() {
  target=$1; source=$2
  if [ -f "$target" ]; then
    # Some managed files, notably sudoers rules, are unreadable to the user.
    # Compare through the same privilege boundary used to install them.
    installed_sum=$(as_root sha256sum "$target" 2>/dev/null | cut -d ' ' -f1)
    source_sum=$(sha256sum "$source" | cut -d ' ' -f1)
    [ "$installed_sum" != "$source_sum" ] || return 0
  fi
  if [ -f "$target" ] && ! owned "$target" && ! legacy_owned "$target" &&
     ! as_root grep -qxF "# NIRUX owner: $PREFIX" "$target" 2>/dev/null; then
    if grep -q '^# NIRUX owner:' "$target" 2>/dev/null; then die "$target belongs to another NIRUX installation"; fi
    [ -f "$target.nirux-backup" ] || as_root cp -p "$target" "$target.nirux-backup"
  fi
  as_root install -d -m 755 "$(dirname "$target")"
  as_root install -m 644 "$source" "$target"
}
prepare_pam() {
  pam_source=$WORK/generation/pam
  for include in $(awk '$2 == "include" || $2 == "substack" {print $3}' "$pam_source"); do
    [ -f "$ROOT/etc/pam.d/$include" ] || die "PAM include $include is missing; install the distribution PAM packages"
  done
  { say "# NIRUX owner: $PREFIX"; cat "$pam_source"; } > "$WORK/pam"
  write_system "$ROOT/etc/pam.d/nirulock" "$WORK/pam"
}
login_wallpaper_config() {
  say "${XDG_CONFIG_HOME:-$HOME/.config}/nirux/login-wallpaper"
}

configured_theme() {
  theme_file=$CONFDIR/config.toml
  theme=
  [ ! -f "$theme_file" ] || theme=$(sed -n 's/^[[:space:]]*theme[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$theme_file" | head -n 1)
  [ -n "$theme" ] || theme=niru-noir
  say "$theme"
}

theme_login_wallpaper() {
  theme=$(configured_theme)
  case "$theme" in
    niru-*) name=${theme#niru-} ;;
    *) name=$theme ;;
  esac
  base=$(pictures_directory)/Wallpapers/NIRU
  for candidate in "$base/nirux-wallpaper-$name-4k.png" "$base/nirux-wallpaper-$name-8k.png" "$base/nirux-wallpaper-$name.png"; do
    if [ -f "$candidate" ] && is_png "$candidate"; then say "$candidate"; return 0; fi
  done
  for candidate in "$base/nirux-wallpaper-noir-4k.png" "$base/nirux-wallpaper-noir-8k.png"; do
    if [ -f "$candidate" ] && is_png "$candidate"; then say "$candidate"; return 0; fi
  done
  return 1
}

default_login_wallpaper() {
  theme_login_wallpaper
}

selected_login_wallpaper() {
  file=$(login_wallpaper_config)
  [ -f "$file" ] || return 1
  selected=$(sed -n '1p' "$file")
  [ -n "$selected" ] && [ -f "$selected" ] || return 1
  say "$selected"
}

is_png() {
  [ "$(od -An -tx1 -N8 "$1" 2>/dev/null | tr -d ' \n')" = "89504e470d0a1a0a" ]
}

apply_login_wallpaper() {
  login_source=$1
  [ -f "$login_source" ] || die "login wallpaper not found: $login_source"
  is_png "$login_source" || die "login wallpaper must be a PNG: $login_source"
  applied=0
  if [ -f "$ROOT/usr/share/sddm/themes/nirux/Main.qml" ] &&
     owned "$ROOT/usr/share/sddm/themes/nirux/Main.qml"; then
    install_login_picture "$login_source" "$ROOT/usr/share/sddm/themes/nirux/background.png" || \
      die 'could not copy the login picture; is the NIRUX login rule installed?' 
    applied=1
  fi
  if [ -f "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" ] &&
     owned "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf"; then
    install_login_picture "$login_source" "$ROOT/usr/share/nirux/greeter/login.png" || \
      die 'could not copy the login picture; is the NIRUX login rule installed?' 
    tmp=$(mktemp)
    sed 's|^background=.*|background=/usr/share/nirux/greeter/login.png|' \
      "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" > "$tmp"
    write_system "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" "$tmp"
    rm -f "$tmp"
    applied=1
  fi
  [ "$applied" = 1 ] || die 'no NIRUX SDDM or LightDM greeter is installed; run nirux install --display-manager sddm|lightdm'
  say "Login wallpaper applied from $login_source. It appears at the next greeter start."
}

login_wallpaper() {
  action=${1:-list}
  destination=$(pictures_directory)/Wallpapers/NIRU
  selected=$(selected_login_wallpaper || :)
  case "$action" in
    list)
      [ -d "$destination" ] || die "wallpaper directory not found: $destination"
      found=0
      for file in "$destination"/*.png; do
        [ -f "$file" ] || continue
        found=1
        if [ "$file" = "$selected" ]; then printf '* %s\n' "${file##*/}"
        else printf '  %s\n' "${file##*/}"; fi
      done
      [ "$found" = 1 ] || die "no PNG wallpapers in $destination"
      default_wallpaper=$(default_login_wallpaper || :)
      say "Current: ${selected:-$default_wallpaper}"
      ;;
    set)
      [ "$#" = 2 ] || die 'login-wallpaper set needs one PNG filename or path'
      login_source=$2
      case "$login_source" in
        */*) : ;;
        *) login_source=$destination/$login_source ;;
      esac
      [ -f "$login_source" ] || die "login wallpaper not found: $login_source"
      apply_login_wallpaper "$login_source"
      mkdir -p "$(dirname "$(login_wallpaper_config)")"
      printf '%s\n' "$login_source" > "$(login_wallpaper_config)"
      ;;
    sync)
      # Follow the theme that is now selected. Called by the theme hook so the
      # greeter background changes with the desktop wallpaper instead of
      # keeping the picture from the last `nirux update`. A wallpaper the user
      # chose explicitly with `login-wallpaper set` is never overridden.
      #
      # It runs under sudo, where HOME is root's, so the desktop user's own
      # configuration and Pictures directory are read through SUDO_USER.
      [ "$#" = 1 ] || die 'login-wallpaper sync takes no arguments'
      sync_user=${SUDO_USER:-}
      if [ -n "$sync_user" ] && [ "$sync_user" != root ]; then
        sync_home=$(getent passwd "$sync_user" 2>/dev/null | cut -d: -f6)
        if [ -n "$sync_home" ] && [ -d "$sync_home" ]; then
          HOME=$sync_home
          export HOME
          # PREFIX and CONFDIR are derived from HOME at startup; re-derive them
          # so ownership checks recognise files the desktop user's install wrote.
          PREFIX=${NIRUX_PREFIX:-$HOME/.local}
          BIN=$PREFIX/bin
          STATE=$PREFIX/share/nirux
          CONFDIR=${XDG_CONFIG_HOME:-$HOME/.config}/niruwm
        fi
      fi
      [ -f "$(login_wallpaper_config)" ] && return 0
      login_source=$(theme_login_wallpaper || :)
      [ -n "$login_source" ] || return 0
      [ -f "$login_source" ] || return 0
      apply_login_wallpaper "$login_source"
      ;;
    reset)
      [ "$#" = 1 ] || die 'login-wallpaper reset takes no arguments'
      login_source=$(default_login_wallpaper)
      [ -f "$login_source" ] || die "default login wallpaper not found: $login_source"
      apply_login_wallpaper "$login_source"
      rm -f "$(login_wallpaper_config)"
      ;;
    *) die 'login-wallpaper needs list, set FILE or reset' ;;
  esac
}

# ── Optional theme wallpaper set ────────────────────────────────────────────
# NIRUX ships only the default theme's wallpaper with its release. The other
# nine themes are a 326 MB set served by the project's own Nextcloud, so a
# routine GitHub release stays small and every update does not re-download it.
# A theme without its image paints its own background colour, so nothing looks
# broken while the set is absent.
WALLPAPER_BUNDLE_URL=https://nextcloud.nirucon.se/s/2b9MX7GZKpLsyGx/download
WALLPAPER_BUNDLE_SHA256=4dd71b0510b7aca125feb6b6fa111fea13239888cd51a3857609e300368098fc
WALLPAPER_BUNDLE_BYTES=326176620
WALLPAPER_THEMES='noir nord satie carl-larsson forest-vigil blood-of-urdr root-and-stone blue-horizon the-norns winter-nights'
# Two optional packs add colour variants (red, blue, green and noir) of the
# Carl Larsson and Erik Satie themes. They are separate from the ten default
# theme wallpapers so choosing one never replaces the theme's own image.
CARL_LARSSON_BUNDLE_URL=https://nextcloud.nirucon.se/s/bmp7adPwQWLgZmH/download
CARL_LARSSON_BUNDLE_SHA256=a1b5a2bd4a4dac3c23a72398aaf0e53e83c86249d1f25501055a2763c9c098ad
CARL_LARSSON_BUNDLE_BYTES=182782549
SATIE_BUNDLE_URL=https://nextcloud.nirucon.se/s/We5oogp7sWwL6Ba/download
SATIE_BUNDLE_SHA256=85b1268aa59e23c4c1b2e3377d7916c7340f62e5199b905f2a322a22617e9ff2
SATIE_BUNDLE_BYTES=83910092
WALLPAPER_EXTRA_COLOURS='red blue green noir'

wallpaper_destination() {
  printf '%s\n' "$(pictures_directory)/Wallpapers/NIRU"
}

# Display layouts are NIRUWM's `displays.toml` profiles, reached from one place
# so a user does not need to remember which program owns them.
layout() {
  sub=${1:-list}
  [ -x "$BIN/niructl" ] || die 'niructl is missing; run nirux update'
  case "$sub" in
    list)
      "$BIN/niructl" display list || die 'could not read the display profiles'
      ;;
    save)
      [ -n "${2:-}" ] || die 'layout save needs a name, for example: nirux layout save Desk'
      "$BIN/niructl" display save "$2" || die "could not save the layout $2"
      say "Layout $2 saved. Apply it with: nirux layout apply $2"
      ;;
    apply)
      [ -n "${2:-}" ] || die 'layout apply needs a name; see nirux layout list'
      "$BIN/niructl" display apply "$2" || die "could not apply the layout $2"
      ;;
    rotate)
      [ -n "${2:-}" ] && [ -n "${3:-}" ] ||
        die 'layout rotate needs an output and normal|left|right|inverted; niructl monitors lists the outputs'
      "$BIN/niructl" display rotate "$2" "$3" || die "could not turn $2 to $3"
      ;;
    auto)
      "$BIN/niructl" display auto || die 'could not arrange the screens'
      ;;
    *) die 'layout takes list, save NAME, apply NAME, rotate OUTPUT ROTATION or auto' ;;
  esac
}

wallpapers() {
  sub=${1:-status}
  case "$sub" in
    status) wallpapers_status ;;
    download)
      wp_choice=${2:-themes}
      case "$wp_choice" in
        themes|extras|all|carl-larsson|satie|erik-satie) ;;
        *) die 'wallpapers download takes themes, extras, all, carl-larsson or satie' ;;
      esac
      # Self-contained command: it can run outside install/update, where WORK
      # and OS are never set. A private directory keeps the archives off /tmp
      # and removes them again. OS is needed only to install unzip when missing.
      OS=${OS:-$(distro)}
      wp_work=$(mktemp -d "${TMPDIR:-/tmp}/nirux-wallpapers.XXXXXX") ||
        die 'could not create a temporary directory'
      trap 'rm -rf "$wp_work"' EXIT HUP INT TERM
      WP_WORK=$wp_work wallpapers_download "$wp_choice"
      ;;
    remove) wallpapers_remove ;;
    *) die 'wallpapers takes status, download or remove' ;;
  esac
}

# How many of the ten themes have a 4k wallpaper installed.
wallpaper_theme_count() {
  wp_count=0
  wp_dir=$(wallpaper_destination)
  for wp_theme in $WALLPAPER_THEMES; do
    [ -f "$wp_dir/nirux-wallpaper-$wp_theme-4k.png" ] && wp_count=$((wp_count + 1))
  done
  printf '%s\n' "$wp_count"
}

# Count the two optional colour-variant packs. Erik Satie's package uses the
# existing `satie` theme slug so the variants sit beside the default theme image.
wallpaper_extra_count() {
  wp_extra_dir=$(wallpaper_destination)
  wp_extra=0
  for wp_pack in carl-larsson satie; do
    for wp_colour in $WALLPAPER_EXTRA_COLOURS; do
      for wp_size in 4k 8k; do
        [ -f "$wp_extra_dir/nirux-wallpaper-$wp_pack-$wp_colour-$wp_size.png" ] &&
          wp_extra=$((wp_extra + 1))
      done
    done
  done
  printf '%s\n' "$wp_extra"
}

wallpapers_status() {
  wp_dir=$(wallpaper_destination)
  wp_have=$(wallpaper_theme_count)
  wp_extra=$(wallpaper_extra_count)
  say "Theme wallpapers: $wp_have of 10 installed in $wp_dir"
  say "Additional colour packs: $wp_extra of 16 installed"
  if [ "$wp_have" -eq 10 ] && [ "$wp_extra" -eq 16 ]; then
    say 'Every theme and additional wallpaper is installed; nothing to download.'
    return 0
  fi
  say ''
  say 'A theme without its own wallpaper uses its background colour, so the'
  say 'desktop still matches the theme. The main set (4k and 8k, ~326 MB):'
  say ''
  say '    nirux wallpapers download themes'
  say ''
  say 'Carl Larsson and Erik Satie colour variants (red, blue, green, noir;'
  say '4k and 8k, ~255 MB together):'
  say ''
  say '    nirux wallpapers download extras'
  say ''
  say 'Download everything: nirux wallpapers download all'
  say 'The same action is offered in the launcher under Wallpaper.'
}

fetch_wallpaper_bundle() {
  wp_dir_work=${WP_WORK:-${WORK:?no work directory}}
  wp_zip=$wp_dir_work/nirux-wallpapers.zip
  rm -f "$wp_zip"
  fetch "$WALLPAPER_BUNDLE_URL" "$wp_zip" ||
    die 'could not download the wallpaper set; check the network connection'
  wp_size=$(wc -c < "$wp_zip" | tr -d ' ')
  [ "$wp_size" = "$WALLPAPER_BUNDLE_BYTES" ] ||
    die "the download was incomplete ($wp_size of $WALLPAPER_BUNDLE_BYTES bytes); run the command again"
  wp_sum=$(sha256sum "$wp_zip" | cut -d ' ' -f1)
  [ "$wp_sum" = "$WALLPAPER_BUNDLE_SHA256" ] ||
    die 'the download did not match its checksum; nothing was installed'
  say 'Download verified.'
}

wallpapers_download_themes() {
  wp_dir=$(wallpaper_destination)
  if [ "$(wallpaper_theme_count)" -eq 10 ]; then
    say 'All ten theme wallpapers are already installed.'
    return 0
  fi
  # unzip is in the package list, but an install made with --no-packages may
  # not have it, and the command is also useful on a machine where only the
  # programs were installed. Install it rather than refusing a 326 MB download
  # the user already asked for.
  if ! command -v unzip >/dev/null 2>&1; then
    say 'Installing unzip, which the wallpaper archive needs...'
    install_packages unzip ||
      die 'unzip is needed to install the wallpaper set; install it and run the command again'
  fi
  say 'Downloading the NIRUX theme wallpapers (~326 MB) from nextcloud.nirucon.se...'
  fetch_wallpaper_bundle
  # Stage everything first: a truncated archive must never leave a half-written
  # set that looks installed.
  wp_stage=${WP_WORK:?no work directory}/wallpapers-stage
  rm -rf "$wp_stage"
  mkdir -p "$wp_stage" || die 'could not create the staging directory'
  unzip -q -o "${WP_WORK:?no work directory}/nirux-wallpapers.zip" -d "$wp_stage" ||
    die 'could not extract the wallpaper set'
  [ -n "$(find "$wp_stage" -name 'nirux-wallpaper-*.png' -print -quit)" ] ||
    die 'the wallpaper set contained no PNG files'

  mkdir -p "$wp_dir" || die "could not create $wp_dir"
  wp_manifest=$(wallpaper_manifest)
  mkdir -p "${wp_manifest%/*}" || die 'could not create the NIRUX state directory'
  : > "$wp_manifest.new"
  wp_installed=0
  for wp_src in "$wp_stage"/nirux-wallpaper-*.png; do
    [ -f "$wp_src" ] || continue
    wp_name=${wp_src##*/}
    # The bundle names two sets with a `noir-` prefix; NIRUX's theme slugs have
    # used the shorter names since 0.10.120. Accept both so the theme lookup
    # finds the file whichever name the bundle was built with.
    case "$wp_name" in
      nirux-wallpaper-noir-the-norns-*.png)
        wp_name=nirux-wallpaper-the-norns-${wp_name##*noir-the-norns-} ;;
      nirux-wallpaper-noir-winter-nights-*.png)
        wp_name=nirux-wallpaper-winter-nights-${wp_name##*noir-winter-nights-} ;;
    esac
    wp_target=$wp_dir/$wp_name
    if [ -f "$wp_target" ]; then
      wp_old=$(awk -v n="$wp_name" '$2 == n {print $1; exit}' "$wp_manifest" 2>/dev/null)
      wp_cur=$(sha256sum "$wp_target" | cut -d ' ' -f1)
      if [ -z "$wp_old" ] || [ "$wp_cur" != "$wp_old" ]; then
        say "Keeping your own $wp_target"
        # Preserve the original ownership hash, never adopt the user's bytes.
        [ -z "$wp_old" ] || printf '%s  %s\n' "$wp_old" "$wp_name" >> "$wp_manifest.new"
        continue
      fi
    fi
    install -m 644 "$wp_src" "$wp_target" || die "could not install $wp_target"
    printf '%s  %s\n' "$(sha256sum "$wp_target" | cut -d ' ' -f1)" "$wp_name" \
      >> "$wp_manifest.new"
    wp_installed=$((wp_installed + 1))
  done
  # Keep any previously recorded file this set did not mention.
  if [ -f "$wp_manifest" ]; then
    while IFS= read -r wp_line; do
      wp_name=${wp_line#*  }
      [ -n "$wp_name" ] || continue
      grep -q "  $wp_name\$" "$wp_manifest.new" && continue
      [ -f "$wp_dir/$wp_name" ] || continue
      printf '%s\n' "$wp_line" >> "$wp_manifest.new"
    done < "$wp_manifest"
  fi
  chmod 644 "$wp_manifest.new" 2>/dev/null || :
  mv -f "$wp_manifest.new" "$wp_manifest" || die 'could not record the installed wallpapers'
  rm -rf "$wp_stage" "${WP_WORK:?no work directory}/nirux-wallpapers.zip"
  say "Installed $wp_installed wallpaper file(s) in $wp_dir"
  say "Themes available now: $(wallpaper_theme_count) of 10"
  refresh_running_theme
}

# Verify and install one optional colour pack. The archive is staged, every
# expected file is checked, and only then is the shared manifest updated.
wallpapers_download_pack() {
  wp_pack=$1
  case "$wp_pack" in
    carl-larsson)
      wp_url=$CARL_LARSSON_BUNDLE_URL
      wp_sha=$CARL_LARSSON_BUNDLE_SHA256
      wp_bytes=$CARL_LARSSON_BUNDLE_BYTES
      wp_label='Carl Larsson'
      ;;
    satie)
      wp_url=$SATIE_BUNDLE_URL
      wp_sha=$SATIE_BUNDLE_SHA256
      wp_bytes=$SATIE_BUNDLE_BYTES
      wp_label='Erik Satie'
      ;;
    *) die "unknown wallpaper pack: $wp_pack" ;;
  esac
  wp_dir=$(wallpaper_destination)
  wp_expected=0
  for wp_colour in $WALLPAPER_EXTRA_COLOURS; do
    for wp_size in 4k 8k; do
      [ -f "$wp_dir/nirux-wallpaper-$wp_pack-$wp_colour-$wp_size.png" ] &&
        wp_expected=$((wp_expected + 1))
    done
  done
  if [ "$wp_expected" -eq 8 ]; then
    say "$wp_label additional wallpapers are already installed."
    return 0
  fi
  if ! command -v unzip >/dev/null 2>&1; then
    say 'Installing unzip, which the wallpaper archive needs...'
    install_packages unzip ||
      die 'unzip is needed to install the extra wallpapers; install it and run the command again'
  fi
  wp_work=${WP_WORK:?no work directory}
  wp_zip=$wp_work/$wp_pack.zip
  rm -f "$wp_zip"
  say "Downloading $wp_label additional wallpapers (~$((wp_bytes / 1024 / 1024)) MB) from nextcloud.nirucon.se..."
  fetch "$wp_url" "$wp_zip" ||
    die "could not download the $wp_label wallpaper pack; check the network connection"
  wp_size_actual=$(wc -c < "$wp_zip" | tr -d ' ')
  [ "$wp_size_actual" = "$wp_bytes" ] ||
    die "the $wp_label download was incomplete ($wp_size_actual of $wp_bytes bytes); run the command again"
  [ "$(sha256sum "$wp_zip" | cut -d ' ' -f1)" = "$wp_sha" ] ||
    die "the $wp_label download did not match its checksum; nothing was installed"
  say 'Download verified.'
  wp_stage=$wp_work/$wp_pack-stage
  rm -rf "$wp_stage"
  mkdir -p "$wp_stage" || die 'could not create the staging directory'
  unzip -q -o "$wp_zip" -d "$wp_stage" ||
    die "could not extract the $wp_label wallpaper pack"
  for wp_colour in $WALLPAPER_EXTRA_COLOURS; do
    for wp_size in 4k 8k; do
      wp_archive_pack=$wp_pack
      [ "$wp_pack" != satie ] || wp_archive_pack=erik-satie
      wp_image=$wp_stage/nirux-wallpaper-$wp_archive_pack-$wp_colour-$wp_size.png
      [ -f "$wp_image" ] && [ ! -L "$wp_image" ] && is_png "$wp_image" ||
        die "the $wp_label wallpaper pack is incomplete or invalid; nothing installed"
    done
  done
  mkdir -p "$wp_dir" || die "could not create $wp_dir"
  wp_manifest=$(wallpaper_manifest)
  mkdir -p "${wp_manifest%/*}" || die 'could not create the NIRUX state directory'
  : > "$wp_manifest.new"
  # Preserve every existing record except the names this pack replaces.
  if [ -f "$wp_manifest" ]; then
    while IFS= read -r wp_line; do
      wp_name=${wp_line#*  }
      [ -n "$wp_name" ] || continue
      case "$wp_name" in
        nirux-wallpaper-$wp_pack-*-4k.png|nirux-wallpaper-$wp_pack-*-8k.png) continue ;;
      esac
      printf '%s\n' "$wp_line" >> "$wp_manifest.new"
    done < "$wp_manifest"
  fi
  wp_installed=0
  for wp_colour in $WALLPAPER_EXTRA_COLOURS; do
    for wp_size in 4k 8k; do
      wp_name=nirux-wallpaper-$wp_pack-$wp_colour-$wp_size.png
      # The Erik Satie archive predates the shorter theme slug. Store it under
      # the slug NIRUX themes use, so the pair is consistent and easy to find.
      wp_source=$wp_stage/nirux-wallpaper-$wp_pack-$wp_colour-$wp_size.png
      [ "$wp_pack" = satie ] &&
        wp_source=$wp_stage/nirux-wallpaper-erik-satie-$wp_colour-$wp_size.png
      [ -f "$wp_source" ] || die "the $wp_label wallpaper pack is missing $wp_source"
      wp_target=$wp_dir/$wp_name
      if [ -f "$wp_target" ]; then
        wp_old=$(awk -v n="$wp_name" '$2 == n {print $1; exit}' "$wp_manifest" 2>/dev/null)
        wp_cur=$(sha256sum "$wp_target" | cut -d ' ' -f1)
        if [ -z "$wp_old" ] || [ "$wp_cur" != "$wp_old" ]; then
          say "Keeping your own $wp_target"
          [ -z "$wp_old" ] || printf '%s  %s\n' "$wp_old" "$wp_name" >> "$wp_manifest.new"
          continue
        fi
      fi
      install -m 644 "$wp_source" "$wp_target" || die "could not install $wp_target"
      printf '%s  %s\n' "$(sha256sum "$wp_target" | cut -d ' ' -f1)" "$wp_name"         >> "$wp_manifest.new"
      wp_installed=$((wp_installed + 1))
    done
  done
  chmod 644 "$wp_manifest.new" 2>/dev/null || :
  mv -f "$wp_manifest.new" "$wp_manifest" || die 'could not record the installed wallpapers'
  rm -rf "$wp_stage" "$wp_zip"
  say "Installed $wp_installed $wp_label wallpaper file(s)."
}

wallpapers_download() {
  wallpapers_lock
  wp_choice=${1:-themes}
  case "$wp_choice" in
    themes|all) wallpapers_download_themes ;;
  esac
  case "$wp_choice" in
    extras|all)
      wallpapers_download_pack carl-larsson
      wallpapers_download_pack satie
      ;;
    carl-larsson) wallpapers_download_pack carl-larsson ;;
    satie|erik-satie) wallpapers_download_pack satie ;;
  esac
}

wallpapers_remove() {
  wallpapers_lock
  wp_dir=$(wallpaper_destination)
  wp_manifest=$(wallpaper_manifest)
  if [ ! -f "$wp_manifest" ]; then
    say 'No NIRUX-installed wallpapers are recorded.'
    return 0
  fi
  wp_removed=0
  : > "$wp_manifest.new"
  while IFS= read -r wp_line; do
    wp_old=${wp_line%%  *}
    wp_name=${wp_line#*  }
    [ -n "$wp_old" ] && [ -n "$wp_name" ] || continue
    # The default theme's wallpaper ships with every release; keep it so a
    # fresh look still works with no network at all.
    case "$wp_name" in
      nirux-wallpaper-noir-4k.png|nirux-wallpaper-noir-8k.png)
        printf '%s\n' "$wp_line" >> "$wp_manifest.new"
        continue
        ;;
    esac
    wp_target=$wp_dir/$wp_name
    if [ ! -f "$wp_target" ]; then
      continue
    fi
    wp_cur=$(sha256sum "$wp_target" | cut -d ' ' -f1)
    if [ "$wp_cur" = "$wp_old" ]; then
      rm -f "$wp_target" && wp_removed=$((wp_removed + 1))
    else
      say "Keeping $wp_target; it was modified"
      printf '%s\n' "$wp_line" >> "$wp_manifest.new"
    fi
  done < "$wp_manifest"
  mv -f "$wp_manifest.new" "$wp_manifest" 2>/dev/null || :
  say "Removed $wp_removed downloaded wallpaper file(s)."
  say 'The default theme keeps its wallpaper; other themes now use their background colour.'
}


sddm_qt_version() {
  if command -v sddm-greeter-qt6 >/dev/null 2>&1; then say 6; else say 5; fi
}
# Allow exactly one thing without a password: replacing the greeter's own
# background picture, which NIRUX owns and this user may write anyway.
#
# Earlier releases granted `NOPASSWD: $HOME/.local/bin/nirux ...`. That path is
# in the user's own installation, so the user could replace the program and have
# root run it: the argument restriction was no protection at all. The rule now
# names the fixed system path the gallery writes, so the grant can never reach
# a user-controlled executable.
# Wi-Fi control on a standalone wpa_supplicant system needs root for the
# control socket and rfkill. The grant names fixed system programs only; the
# user's own prefix can never match. NetworkManager systems use their normal
# D-Bus policy instead and do not need this rule.
install_wifi_rule() {
  [ -n "${rule_user:-}" ] || return 0
  wifi_source=$WORK/wifi-integration/polkit/nirux-wifi
  wifi_archive=$WORK/download/nirux/nirux-integration.tar.xz
  if [ -f "$wifi_archive" ]; then
    mkdir -p "$WORK/wifi-integration"
    tar -xJf "$wifi_archive" -C "$WORK/wifi-integration" ./polkit/nirux-wifi 2>/dev/null || :
  fi
  [ -f "$wifi_source" ] || {
    # Older release fixtures may not ship the helper; never retain a broad grant.
    remove_system "$ROOT/etc/sudoers.d/49-nirux-wifi"
    return 0
  }
  wifi_helper=$ROOT/usr/libexec/nirux-wifi
  {
    say '#!/usr/bin/python3'
    say "# NIRUX owner: $PREFIX"
    sed '1d' "$wifi_source"
  } > "$WORK/wifi-helper"
  write_system "$wifi_helper" "$WORK/wifi-helper"
  as_root chmod 0755 "$wifi_helper" || die 'could not secure Wi-Fi helper'
  {
    say "# NIRUX owner: $PREFIX"
    say '# Only the root-owned request validator is authorized, never raw wpa_cli.'
    say "$rule_user ALL=(root) NOPASSWD: /usr/libexec/nirux-wifi"
  } > "$WORK/wifi-sudoers"
  if command -v visudo >/dev/null 2>&1; then
    visudo -cf "$WORK/wifi-sudoers" >/dev/null 2>&1 ||
      die 'generated Wi-Fi sudoers rule is invalid; nothing was installed'
  fi
  wifi_sudoers=$ROOT/etc/sudoers.d/49-nirux-wifi
  if [ -f "$wifi_sudoers" ] && [ "$(as_root cat "$wifi_sudoers" 2>/dev/null)" = "$(cat "$WORK/wifi-sudoers")" ]; then
    :
  else
    write_system "$wifi_sudoers" "$WORK/wifi-sudoers"
  fi
  as_root chmod 0440 "$wifi_sudoers" || die 'could not secure the Wi-Fi sudoers rule'
}

install_login_wallpaper_rule() {
  legacy_file=$ROOT/etc/sudoers.d/49-nirux-login-wallpaper
  # The unsafe rule from earlier releases goes first, whatever happens next: it
  # must not stay merely because writing its replacement failed.
  if as_root test -f "$legacy_file" && as_root grep -q 'login-wallpaper sync' "$legacy_file" 2>/dev/null; then
    say 'Withdrawing the previous passwordless login-wallpaper rule'
    as_root rm -f "$legacy_file"
  fi
  # One grant per greeter picture this release installed, and nothing else.
  # sudo matches a command by its exact arguments, and those name /usr/bin/install
  # with one staged file and one greeter path. No program from the user's own
  # prefix can ever match, which is what made the old rule unsafe.
  sddm_picture=$ROOT/usr/share/sddm/themes/nirux/background.png
  lightdm_picture=$ROOT/usr/share/nirux/greeter/login.png
  targets=
  [ ! -f "$sddm_picture" ] || targets="$targets /usr/share/sddm/themes/nirux/background.png:/usr/share/sddm/themes/nirux"
  [ ! -f "$lightdm_picture" ] || targets="$targets /usr/share/nirux/greeter/login.png:/usr/share/nirux/greeter"
  if [ -z "$targets" ] || [ -z "${rule_user:-}" ]; then
    # No greeter was installed here, or no desktop user could be named: keep no
    # grant that nothing needs.
    if as_root test -f "$legacy_file"; then as_root rm -f "$legacy_file"; fi
    return 0
  fi
  {
    say "# NIRUX owner: $PREFIX"
    say "# Lets a theme change copy the login screen picture without a password."
    say "# Each rule names /usr/bin/install, the staged picture and one greeter"
    say "# file, so nothing else can be run as root through it."
    for entry in $targets; do
      picture=${entry%%:*}
      directory=${entry#*:}
      say "$rule_user ALL=(root) NOPASSWD: /usr/bin/install -d -m 755 $directory"
      say "$rule_user ALL=(root) NOPASSWD: /usr/bin/install -m 644 -o root -g root /tmp/nirux-login-background.png $picture"
    done
  } > "$WORK/sudoers"
  if command -v visudo >/dev/null 2>&1; then
    tmp_check="$WORK/sudoers.check"
    cat "$WORK/sudoers" > "$tmp_check"
    visudo -cf "$tmp_check" >/dev/null 2>&1 ||
      die 'generated sudoers rule is invalid; nothing was installed'
    rm -f "$tmp_check"
  fi
  sudoers_file=$ROOT/etc/sudoers.d/49-nirux-login-wallpaper
  # write_system compares the file by reading it, and sudoers.d is closed to
  # this user, so an unchanged rule is compared by root and left alone.
  # Compare by reading, since sudoers.d is closed to this user.
  if [ -f "$sudoers_file" ] && [ "$(as_root cat "$sudoers_file" 2>/dev/null)" = "$(cat "$WORK/sudoers")" ]; then
    :
  else
    write_system "$sudoers_file" "$WORK/sudoers"
  fi
  # sudo ignores a writable file in sudoers.d, and does so silently.
  # write_system installs 0644, so this one needs its mode set explicitly.
  if [ "$(as_root stat -c %a "$sudoers_file" 2>/dev/null || :)" != 440 ]; then
    as_root chmod 0440 "$sudoers_file"
  fi
}

# Copy the login picture as root through the named grant. The picture is staged
# at the fixed path the rule names and removed again; nothing else is passed to
# root, so the grant cannot become "run this program as root".
install_login_picture() {
  source=$1
  target=$2
  if [ "$(id -u)" = 0 ]; then
    install -d -m 755 "$(dirname "$target")" && install -m 644 -o root -g root "$source" "$target"
    return
  fi
  stage=/tmp/nirux-login-background.png
  rm -f "$stage"
  ( umask 022; install -m 644 "$source" "$stage" ) || return 1
  # The rule names /usr/bin/install with these exact arguments; a PATH lookup
  # of bare `install` would not match it.
  if sudo -n /usr/bin/install -m 644 -o root -g root "$stage" "$target" 2>/dev/null; then
    rm -f "$stage"
    return 0
  fi
  rm -f "$stage"
  return 1
}

install_greeters() {
  greeter_dm=${1:-keep}
  # `keep` must still install a themed greeter on the display manager the
  # machine actually uses. Looking only for NIRUX's own files meant that a
  # machine whose greeter was never installed stayed without a theme and
  # without the theme wallpaper forever: every update asked for "keep", found
  # nothing of its own, and did nothing.
  case "$greeter_dm" in
    keep)
      if [ -f "$ROOT/etc/sddm.conf.d/50-nirux.conf" ] && owned "$ROOT/etc/sddm.conf.d/50-nirux.conf"; then
        greeter_dm=sddm
      elif [ -f "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" ] &&
           owned "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf"; then
        greeter_dm=lightdm
      else
        # No NIRUX greeter yet: adopt the display manager in use, never a
        # different one. `existing_dm` reports what is installed.
        case "$(existing_dm)" in
          sddm|lightdm) greeter_dm=$(existing_dm) ;;
        esac
      fi
      ;;
  esac

  archive=$WORK/download/nirux/nirux-integration.tar.xz
  [ -f "$archive" ] || return 0
  unpack=$WORK/integration-unpack
  rm -rf "$unpack"
  mkdir -p "$unpack" || die 'could not create the integration extraction directory'
  tar -xJf "$archive" -C "$unpack" || die 'could not extract the NIRUX integration assets'
  [ -f "$unpack/polkit/49-nirux-power.rules" ] || die 'integration archive is missing the power rule'
  login_wallpaper_source=$(selected_login_wallpaper || theme_login_wallpaper || :)
  if [ -n "$login_wallpaper_source" ]; then
    is_png "$login_wallpaper_source" || die "selected login wallpaper is not a PNG: $login_wallpaper_source"
    say "Using selected login wallpaper: $login_wallpaper_source"
  else
    login_wallpaper_source=$unpack/background.png
  fi
  [ -f "$login_wallpaper_source" ] || die "login wallpaper not found: $login_wallpaper_source"
  # The installing account can already use sudo, so it is also trusted for the
  # local power menu even when sudo comes from a sudoers rule rather than a
  # wheel/sudo group membership. Remote sessions remain excluded.
  rule_user=${SUDO_USER:-$(id -un)}
  if [ -d "$PREFIX" ]; then
    prefix_owner=$(stat -c '%U' "$PREFIX" 2>/dev/null || :)
    [ -z "$prefix_owner" ] || [ "$prefix_owner" = root ] || rule_user=$prefix_owner
  fi
  case "$rule_user" in *[!A-Za-z0-9._-]*) rule_user= ;; esac
  { say "// NIRUX owner: $PREFIX"; sed "s/__NIRUX_USER__/$rule_user/g" "$unpack/polkit/49-nirux-power.rules"; } > "$WORK/power.rules"
  write_system "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules" "$WORK/power.rules"

  case "$greeter_dm" in
    sddm)
      for file in theme.conf arrow.png; do
        [ -f "$unpack/sddm/$file" ] || die "integration archive is missing sddm/$file"
        write_system "$ROOT/usr/share/sddm/themes/nirux/$file" "$unpack/sddm/$file"
      done
      [ -f "$unpack/sddm/metadata.desktop" ] || die 'integration archive is missing sddm/metadata.desktop'
      # Trixie supplies only sddm-greeter-qt6. Without QtVersion, SDDM
      # assumes Qt5 and silently replaces the NIRUX theme with its fallback.
      { say "# NIRUX owner: $PREFIX"; sed '/^QtVersion=/d' "$unpack/sddm/metadata.desktop"; say "QtVersion=$(sddm_qt_version)"; } > "$WORK/sddm-metadata.desktop"
      write_system "$ROOT/usr/share/sddm/themes/nirux/metadata.desktop" "$WORK/sddm-metadata.desktop"
      write_system "$ROOT/usr/share/sddm/themes/nirux/background.png" "$login_wallpaper_source"
      [ -f "$unpack/sddm/Main.qml" ] || die 'integration archive is missing sddm/Main.qml'
      { say "// NIRUX owner: $PREFIX"; cat "$unpack/sddm/Main.qml"; } > "$WORK/sddm-Main.qml"
      write_system "$ROOT/usr/share/sddm/themes/nirux/Main.qml" "$WORK/sddm-Main.qml"
      { say "# NIRUX owner: $PREFIX"; say '[Theme]'; say 'Current=nirux'; } > "$WORK/sddm-nirux.conf"
      write_system "$ROOT/etc/sddm.conf.d/50-nirux.conf" "$WORK/sddm-nirux.conf"
      say 'Installed NIRUX SDDM greeter'
      ;;
    lightdm)
      [ -f "$unpack/lightdm/50-nirux.conf" ] || die 'integration archive is missing the LightDM greeter config'
      [ -f "$unpack/gtk/index.theme" ] || die 'integration archive is missing the GTK theme'
      [ -f "$unpack/gtk/gtk-3.0/gtk.css" ] || die 'integration archive is missing the GTK stylesheet'
      as_root install -d -m 755 "$ROOT/usr/share/nirux/greeter"
      write_system "$ROOT/usr/share/nirux/greeter/login.png" "$login_wallpaper_source"
      [ ! -f "$ROOT/usr/share/nirux/greeter/rooted-in-less.png" ] || as_root rm -f "$ROOT/usr/share/nirux/greeter/rooted-in-less.png"
      { say "# NIRUX owner: $PREFIX"; sed 's|^background=.*|background=/usr/share/nirux/greeter/login.png|' "$unpack/lightdm/50-nirux.conf"; } > "$WORK/lightdm-nirux.conf"
      write_system "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" \
        "$WORK/lightdm-nirux.conf"
      { say "# NIRUX owner: $PREFIX"; cat "$unpack/gtk/index.theme"; } > "$WORK/gtk-index.theme"
      write_system "$ROOT/usr/share/themes/NIRU/index.theme" "$WORK/gtk-index.theme"
      { say "/* NIRUX owner: $PREFIX */"; cat "$unpack/gtk/gtk-3.0/gtk.css"; } > "$WORK/gtk.css"
      write_system "$ROOT/usr/share/themes/NIRU/gtk-3.0/gtk.css" "$WORK/gtk.css"
      say 'Installed NIRUX LightDM GTK greeter'
      ;;
  esac
  # The login screen follows the theme without a password: the grant names the
  # picture file the greeter above actually installed.
  install_login_wallpaper_rule
  rm -rf "$unpack"
}

remove_greeters() {
