  fi
  say "Keeping existing $cfg_file"
  if [ -L "$cfg_file" ]; then
    cfg_target=$(readlink -f "$cfg_file" 2>/dev/null || :)
    if [ -z "$cfg_target" ] || [ ! -f "$cfg_target" ]; then
      die "$cfg_file is a symlink that does not resolve to a regular file; configuration migration stopped"
    fi
  else
    [ -f "$cfg_file" ] || die "$cfg_file is not a regular file; configuration migration stopped"
    cfg_target=$cfg_file
  fi
  cfg_mode=$(stat -c %a "$cfg_target") || die "could not read permissions for $cfg_target"
  cfg_candidate=$(mktemp "$(dirname "$cfg_target")/.$(basename "$cfg_target").nirux.XXXXXX") || \
    die "could not stage configuration next to $cfg_target"
  CONFIG_CANDIDATE=$cfg_candidate
  if ! cp -p "$cfg_target" "$cfg_candidate" || ! chmod u+w "$cfg_candidate"; then
    rm -f "$cfg_candidate"; CONFIG_CANDIDATE=
    die "could not stage configuration for $cfg_file"
  fi
  if config_errors "$cfg_candidate"; then
    rm -f "$cfg_candidate"; CONFIG_CANDIDATE=
    die "configuration migration stopped: unsupported or invalid TOML (original kept)"
  fi
  cfg_before=$(sha256sum "$cfg_candidate" | cut -d ' ' -f1)
  add_missing_sections "$cfg_candidate" "$cfg_example"
  add_missing_top_key "$cfg_candidate" nirupi_compat false
  add_missing_top_key "$cfg_candidate" restore_session false
  add_missing_top_key "$cfg_candidate" weather_latitude 58.22
  add_missing_top_key "$cfg_candidate" weather_longitude 11.93
  add_missing_key "$cfg_candidate" nightlight mode '"manual"'
  add_missing_key "$cfg_candidate" nightlight on '"20:00"'
  add_missing_key "$cfg_candidate" nightlight off '"07:00"'
  add_missing_key "$cfg_candidate" nightlight day_temperature 6500
  add_missing_key "$cfg_candidate" brightness device '""'
  add_missing_key "$cfg_candidate" brightness step 5
  add_missing_key "$cfg_candidate" bar title_delay_seconds 0
  add_missing_key "$cfg_candidate" bar graph_width 24
  add_missing_key "$cfg_candidate" bar tray true
  add_missing_key "$cfg_candidate" wallpaper scale "\"fill\""
  add_missing_key "$cfg_candidate" wallpaper files "[]"
  add_missing_key "$cfg_candidate" wallpaper shuffle_on_start true
  add_missing_key "$cfg_candidate" wallpaper follow_theme true
  add_missing_key "$cfg_candidate" wallpaper theme_dir '"~/Pictures/Wallpapers/NIRU"'
  add_missing_key "$cfg_candidate" monitors workspaces 9
  upgrade_obsolete_default_browser "$cfg_candidate"
  cfg_after=$(sha256sum "$cfg_candidate" | cut -d ' ' -f1)
  if [ "$cfg_before" = "$cfg_after" ]; then
    rm -f "$cfg_candidate"; CONFIG_CANDIDATE=
    say 'No missing configuration settings; existing values unchanged.'
    return 0
  fi
  if config_errors "$cfg_candidate"; then
    rm -f "$cfg_candidate"; CONFIG_CANDIDATE=
    die "configuration migration stopped: candidate is not valid TOML (original kept)"
  fi
  if ! validate_config_candidate "$cfg_candidate"; then
    rm -f "$cfg_candidate"; CONFIG_CANDIDATE=
    die "configuration candidate was rejected; original kept"
  fi
  if ! chmod "$cfg_mode" "$cfg_candidate" || ! mv -f "$cfg_candidate" "$cfg_target"; then
    rm -f "$cfg_candidate"; CONFIG_CANDIDATE=
    die "could not activate $cfg_file; original kept"
  fi
  CONFIG_CANDIDATE=
  say "Migrated $cfg_file with missing defaults; existing values kept."
  return 0
}

existing_dm() {
  dm_unit=$ROOT/etc/systemd/system/display-manager.service
  if [ -L "$dm_unit" ]; then basename "$(readlink "$dm_unit")" .service; return; fi
  for candidate in sddm lightdm gdm lxdm xdm ly; do
    if [ -e "$ROOT/var/service/$candidate" ] || command -v "$candidate" >/dev/null 2>&1; then
      say "$candidate"; return
    fi
  done
}
choose_dm() {
  EXISTING_DM=$(existing_dm)
  if [ "$DM" = auto ]; then
    if [ -n "$EXISTING_DM" ]; then DM=keep
    elif [ -t 0 ]; then
      say "No display manager found. Choose: 1) startx (default) 2) SDDM 3) LightDM"
      printf 'Choice [1]: '
      IFS= read -r answer || answer=1
      case "$answer" in ''|1|startx) DM=startx ;; 2|sddm) DM=sddm ;; 3|lightdm) DM=lightdm ;; *) die "invalid display-manager choice" ;; esac
    else DM=startx
    fi
  fi
  case "$DM" in
    startx|keep) ;;
    sddm|lightdm)
      [ -z "$EXISTING_DM" ] || [ "$EXISTING_DM" = "$DM" ] || die "existing display manager is $EXISTING_DM; disable it explicitly before choosing $DM"
      ;;
    *) die "display manager must be auto, startx, sddm or lightdm" ;;
  esac
  say "Session entry: $DM${EXISTING_DM:+ (existing: $EXISTING_DM)}"
}
fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL --connect-timeout 20 --max-time 300 --retry 3 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -T 60 -t 3 -O "$2" "$1"
  else die "install curl or wget and ca-certificates first"
  fi
}
valid_version() {
  case "$1" in ''|*[!0-9.]*|.*|*.) return 1 ;; *) return 0 ;; esac
}
verify() {
  expected=$(awk -v n="$2" '$2 == n {print $1}' "$1/SHA256SUMS")
  [ "${#expected}" = 64 ] || die "missing or ambiguous checksum for $2"
  case "$expected" in *[!0-9a-fA-F]*) die "invalid checksum for $2" ;; esac
  actual=$(sha256sum "$1/$2" | cut -d ' ' -f1)
  [ "$actual" = "$expected" ] || die "checksum mismatch for $2; current installation kept"
}
release_files() {
  download_repo=$1; download_version=$2; shift 2
  valid_version "$download_version" || die "invalid version: $download_version"
  download_dir=$WORK/download/$download_repo
  mkdir -p "$download_dir"
  download_base=https://github.com/nirucon/$download_repo/releases/download/v$download_version
  fetch "$download_base/SHA256SUMS" "$download_dir/SHA256SUMS"
  for download_file in "$@"; do
    fetch "$download_base/$download_file" "$download_dir/$download_file"
    verify "$download_dir" "$download_file"
  done
}
release_optional_file() {
  download_repo=$1; download_version=$2; download_file=$3
  download_dir=$WORK/download/$download_repo
  [ -f "$download_dir/SHA256SUMS" ] || return 0
  awk -v n="$download_file" '$2 == n {found = 1} END {exit !found}' \
    "$download_dir/SHA256SUMS" || return 0
  download_base=https://github.com/nirucon/$download_repo/releases/download/v$download_version
  fetch "$download_base/$download_file" "$download_dir/$download_file"
  verify "$download_dir" "$download_file"
}

# ── Managed Helium browser ──────────────────────────────────────────────────
# The browser is not part of a program generation: it is a large external
# application with its own release cadence. Its verified files live under the
# NIRUX state directory, one stable link is exposed in BIN, and the persistent
# policy file records whether the user selected it or opted out.
browser_policy() {
  [ -f "$STATE/browser-policy" ] || { say keep; return 0; }
  policy=$(awk '$1 == "browser" && ($2 == "helium" || $2 == "none") {print $2; exit}' "$STATE/browser-policy")
  [ -n "$policy" ] || policy=keep
  say "$policy"
}
browser_policy_set() {
  mkdir -p "$STATE"
  printf '# NIRUX owner: %s\nbrowser %s\n' "$PREFIX" "$1" > "$STATE/.browser-policy.$$" || \
    die 'could not stage the browser policy'
  mv -f "$STATE/.browser-policy.$$" "$STATE/browser-policy" || \
    die 'could not persist the browser policy'
}
browser_managed() {
  [ -L "$BIN/helium" ] || return 1
  [ "$(readlink "$BIN/helium")" = "$STATE/browser-current/helium" ]
}
browser_unmanaged() {
  if [ -e "$BIN/helium" ] && ! browser_managed; then say "$BIN/helium"; return 0; fi
  path=$(command -v helium 2>/dev/null || :)
  if [ -n "$path" ] && [ "$path" != "$BIN/helium" ] && [ -x "$path" ]; then say "$path"; return 0; fi
  return 1
}
browser_path() {
  if browser_managed; then say "$BIN/helium"; return 0; fi
  browser_unmanaged
}
browser_installed_version() {
  [ -x "$BIN/helium" ] || return 1
  "$BIN/helium" --version 2>/dev/null | sed -n 's/^Helium \([0-9][0-9.]*\).*/\1/p' | head -n 1
}
write_prefix_file() {
  target=$1; source=$2
  if [ -f "$target" ]; then
    installed_sum=$(sha256sum "$target" | cut -d ' ' -f1)
    source_sum=$(sha256sum "$source" | cut -d ' ' -f1)
    [ "$installed_sum" != "$source_sum" ] || return 0
  fi
  if [ -f "$target" ] && ! owned "$target"; then
    [ -f "$target.nirux-backup" ] || cp -p "$target" "$target.nirux-backup" || \
      die "could not back up $target"
  fi
  mkdir -p "$(dirname "$target")" || die "could not create $(dirname "$target")"
  install -m 644 "$source" "$target" || die "could not install $target"
}
remove_prefix_file() {
  if [ -f "$1" ] && owned "$1"; then
    if [ -f "$1.nirux-backup" ]; then mv -f "$1.nirux-backup" "$1"
    else rm -f "$1"
    fi
  fi
}
browser_desktop_file() {
  say "$PREFIX/share/applications/helium.desktop"
}
browser_write_desktop() {
  desktop_source=$STATE/browser-current/helium.desktop
  desktop_target=$(browser_desktop_file)
  mkdir -p "$WORK"
  if [ -f "$desktop_source" ]; then
    {
      say "# NIRUX owner: $PREFIX"
      sed -e "s|^Exec=helium|Exec=\"$BIN/helium\"|" \
          -e "s|^Icon=helium\$|Icon=$STATE/browser-current/product_logo_256.png|" \
          "$desktop_source"
    } > "$WORK/helium.desktop"
  else
    {
      say "# NIRUX owner: $PREFIX"
      say '[Desktop Entry]'
      say 'Name=Helium'
      say 'Comment=Access the Internet'
      say 'Type=Application'
      say "Exec=\"$BIN/helium\" %U"
      say "Icon=$STATE/browser-current/product_logo_256.png"
      say 'Terminal=false'
      say 'Categories=Network;WebBrowser;'
      say 'MimeType=application/pdf;application/rdf+xml;application/rss+xml;application/xhtml+xml;text/html;text/xml;x-scheme-handler/http;x-scheme-handler/https;'
    } > "$WORK/helium.desktop"
  fi
  write_prefix_file "$desktop_target" "$WORK/helium.desktop"
}
browser_remove_managed() {
  remove_prefix_file "$(browser_desktop_file)"
  if [ -L "$BIN/helium" ]; then
    case "$(readlink "$BIN/helium")" in
      "$STATE/browser-current/helium"|"$STATE/browsers"/*) rm -f "$BIN/helium" ;;
    esac
  fi
  rm -rf "$STATE/browser-current" "$STATE/browsers"
}
browser_remove_policy() {
  rm -f "$STATE/browser-policy"
}
browser_verify_archive() {
  [ -f "$1" ] || die "Helium archive is missing: $1"
  case "$HELIUM_SHA256" in
    *[!0-9a-fA-F]*|'') die 'Helium checksum is invalid' ;;
  esac
  [ "${#HELIUM_SHA256}" = 64 ] || die 'Helium checksum is invalid'
  actual=$(sha256sum "$1" | cut -d ' ' -f1)
  [ "$actual" = "$HELIUM_SHA256" ] || \
    die "Helium checksum mismatch; current browser kept"
}
browser_install_archive() {
  archive=$1
  [ -n "${WORK:-}" ] || die 'browser installation requires a working directory'
  browser_verify_archive "$archive"
  unpack=$WORK/helium-unpack
  rm -rf "$unpack"
  mkdir -p "$unpack" || die 'could not create the Helium extraction directory'
  tar -xJf "$archive" -C "$unpack" || die 'could not extract the Helium archive'
  top=$unpack/helium-$HELIUM_VERSION-x86_64_linux
  [ -x "$top/helium" ] || die 'Helium archive is missing the executable'
  load_output=$(LD_TRACE_LOADED_OBJECTS=1 "$top/helium" 2>&1 || :)
  missing_libs=$(printf '%s\n' "$load_output" | awk '/not found/ {print $1}' | sort -u)
  if [ -n "$missing_libs" ]; then
    die "Helium needs missing shared libraries: $(printf '%s' "$missing_libs" | tr '\n' ' ')"
  fi
  reported=$("$top/helium" --version 2>&1) || die 'the extracted Helium executable cannot start'
  case "$reported" in
    *"$HELIUM_VERSION"*) ;;
    *) die "Helium reports an unexpected version: $reported" ;;
  esac
  mkdir -p "$STATE/browsers" || die 'could not create the managed browser directory'
  destination=$STATE/browsers/helium-$HELIUM_VERSION
  staging=$STATE/browsers/.helium-$HELIUM_VERSION.$$
  rm -rf "$staging"
  mv "$top" "$staging" || die 'could not stage the Helium files'
  rm -rf "$destination"
  mv "$staging" "$destination" || die 'could not install the Helium files'
  mkdir -p "$BIN" || die 'could not create the command directory'
  ln -s "$destination" "$STATE/.browser-current.$$" || die 'could not link Helium'
  mv -Tf "$STATE/.browser-current.$$" "$STATE/browser-current" || die 'could not activate Helium'
  ln -s "$STATE/browser-current/helium" "$BIN/.helium.$$" || die 'could not link the Helium command'
  mv -Tf "$BIN/.helium.$$" "$BIN/helium" || die 'could not activate the Helium command'
  for old in "$STATE/browsers"/helium-*; do
    [ ! -d "$old" ] || [ "$old" = "$destination" ] || rm -rf "$old"
  done
  rm -rf "$unpack"
  browser_write_desktop
  say "Installed managed Helium $HELIUM_VERSION"
}
browser_install() {
  [ "${BROWSER_EFFECTIVE:-keep}" = helium ] || return 0
  if external=$(browser_unmanaged); then
    say "Using the existing Helium at $external; NIRUX will not overwrite it."
    return 0
  fi
  if browser_managed; then
    installed=$(browser_installed_version || :)
    if [ "$installed" = "$HELIUM_VERSION" ]; then
      browser_write_desktop
      say "Managed Helium $HELIUM_VERSION is already installed"
      return 0
    fi
  fi
  [ -n "${WORK:-}" ] || die 'browser installation requires a working directory'
  archive=$WORK/download/helium/helium-$HELIUM_VERSION-x86_64_linux.tar.xz
  mkdir -p "$WORK/download/helium" || die 'could not create the Helium download directory'
  say "Downloading Helium $HELIUM_VERSION"
  fetch "https://github.com/imputnet/helium-linux/releases/download/$HELIUM_VERSION/helium-$HELIUM_VERSION-x86_64_linux.tar.xz" "$archive"
  browser_install_archive "$archive"
}
choose_browser() {
  operation=$1
  persisted=$(browser_policy)
  if [ "$BROWSER_EXPLICIT" = 1 ]; then
    effective=$BROWSER_CHOICE
  elif [ "$operation" = install ]; then
    if [ "$persisted" != keep ]; then
      effective=$persisted
    elif [ -t 0 ]; then
      say 'Install the managed Helium browser? Its runtime dependencies are installed by NIRUX.'
      printf 'Install Helium [Y/n]: '
      IFS= read -r answer || answer=yes
      case "$answer" in [nN]*) effective=none ;; *) effective=helium ;; esac
    else
      effective=helium
    fi
  else
    effective=$persisted
  fi
  case "$effective" in
    helium|none) ;;
    keep)
      # A fresh noninteractive install still needs a usable default. An update
      # with no recorded policy keeps the machine's existing browser untouched.
      [ "$operation" = install ] && effective=helium
      ;;
    *) die 'browser must be helium, none or keep' ;;
  esac
  BROWSER_EFFECTIVE=$effective
}
manifest_version() {
  value=$(awk -v n="$1" '$1 == n {print $2}' "$WORK/download/nirux/manifest")
  valid_version "$value" || die "invalid manifest entry: $1"
  say "$value"
}
component_files() {
  case "$1" in
    niruwm) say "niruwm niructl niruidle niruwm-session" ;;
    *) say "$1" ;;
  esac
}
stage_component_assets() {
  component=$1
  component_version=$2
  case "$component" in
    niruwm) release_files niruwm "$component_version" niruwm niructl niruidle niruwm-session ;;
    nirulock) release_files nirulock "$component_version" nirulock pam-arch pam-debian pam-void ;;
    nirux) : ;;
    *) release_files "$component" "$component_version" "$component" ;;
  esac
}
manifest_components() {
  awk '$1 != "schema" && $1 != "suite" {print $1}' "$WORK/download/nirux/manifest"
}
verify_staged_version() {
  staged_program=$1
  staged_version=$2
  [ -x "$WORK/generation/bin/$staged_program" ] || die "staged $staged_program is missing or not executable"
  staged_reported=$("$WORK/generation/bin/$staged_program" --version | awk '{print $2}')
  [ "$staged_reported" = "$staged_version" ] || die "$staged_program does not report expected version $staged_version"
}
stage_components() {
  stage_suite=$(manifest_version suite)
  # These components are part of the desktop contract even if a future manifest
  # adds more entries.
  for required in niruwm nirubar niruscreensaver nirulock nirulauncher nirunotify; do
    manifest_version "$required" >/dev/null
  done
  mkdir -p "$WORK/generation/bin"
  install -m 755 "$WORK/download/nirux/nirux" "$WORK/generation/bin/nirux"
  # The manifest, not a hardcoded list in the running installer, decides which
  # components this release contains. Unknown components use the convention of
  # one release asset with the component name.
  for component in $(manifest_components); do
    [ "$component" = nirux ] && continue
    component_version=$(manifest_version "$component")
    stage_component_assets "$component" "$component_version"
    for staged_program in $(component_files "$component"); do
      staged_source=$WORK/download/$component/$staged_program
      [ -f "$staged_source" ] || die "release $component $component_version is missing $staged_program"
      install -m 755 "$staged_source" "$WORK/generation/bin/$staged_program"
    done
  done
  cp "$WORK/download/nirux/manifest" "$WORK/generation/manifest"
  [ -f "$WORK/download/nirulock/pam-$OS" ] || die "release nirulock is missing pam-$OS"
  cp "$WORK/download/nirulock/pam-$OS" "$WORK/generation/pam"
  verify_staged_version nirux "$stage_suite"
  # Running --version also catches missing loaders/shared libraries before activation.
  for component in $(manifest_components); do
    [ "$component" = nirux ] && continue
    component_version=$(manifest_version "$component")
    case "$component" in
      niruwm)
        verify_staged_version niruwm "$component_version"
        verify_staged_version niruidle "$component_version"
        ;;
      *) verify_staged_version "$component" "$component_version" ;;
    esac
  done
}
stage_target_release() {
  [ "$1" = 1 ] || die "unsupported staging protocol: $1"
  [ -n "${NIRUX_STAGE_WORK:-}" ] || die 'staging work directory is missing'
  WORK=$NIRUX_STAGE_WORK
  OS=${NIRUX_PROVISION_OS:-$(distro)}
  [ "$(manifest_version schema)" = 1 ] || die "unsupported manifest schema"
  [ "$(manifest_version suite)" = "$VERSION" ] || die "target installer/manifest version mismatch"
  stage_components
}
apply_prepare_backup() {
  mkdir -p "$WORK/apply-backup" || die 'could not create the apply backup directory'
  APPLY_CONFIG_TARGET=$CONFDIR/config.toml
  APPLY_CONFIG_EXISTED=0
  if [ -e "$CONFDIR/config.toml" ] || [ -L "$CONFDIR/config.toml" ]; then
    if [ -L "$CONFDIR/config.toml" ]; then
      APPLY_CONFIG_TARGET=$(readlink -f "$CONFDIR/config.toml" 2>/dev/null || :)
      [ -n "$APPLY_CONFIG_TARGET" ] || die 'the configuration symlink does not resolve'
    fi
    cp -p "$APPLY_CONFIG_TARGET" "$WORK/apply-backup/config.toml" || \
      die 'could not back up the configuration before apply'
    APPLY_CONFIG_EXISTED=1
  fi
  APPLY_APPEARANCE_TARGET=$CONFDIR/appearance.toml
  APPLY_APPEARANCE_EXISTED=0
  if [ -e "$CONFDIR/appearance.toml" ] || [ -L "$CONFDIR/appearance.toml" ]; then
    if [ -L "$CONFDIR/appearance.toml" ]; then
      APPLY_APPEARANCE_TARGET=$(readlink -f "$CONFDIR/appearance.toml" 2>/dev/null || :)
      [ -n "$APPLY_APPEARANCE_TARGET" ] || die 'the appearance symlink does not resolve'
    fi
    cp -p "$APPLY_APPEARANCE_TARGET" "$WORK/apply-backup/appearance.toml" || \
      die 'could not back up the appearance file before apply'
    APPLY_APPEARANCE_EXISTED=1
  fi
}
apply_restore_config() {
  if [ "$APPLY_OK" = 1 ]; then
    rm -rf "$WORK/apply-backup"
    return 0
  fi
  if [ -n "${APPLY_CONFIG_TARGET:-}" ]; then
    if [ "${APPLY_CONFIG_EXISTED:-0}" = 1 ]; then
      cp -p "$WORK/apply-backup/config.toml" "$APPLY_CONFIG_TARGET" 2>/dev/null || :
    else
      rm -f "$APPLY_CONFIG_TARGET" 2>/dev/null || :
    fi
  fi
  if [ -n "${APPLY_APPEARANCE_TARGET:-}" ]; then
    if [ "${APPLY_APPEARANCE_EXISTED:-0}" = 1 ]; then
      cp -p "$WORK/apply-backup/appearance.toml" "$APPLY_APPEARANCE_TARGET" 2>/dev/null || :
    else
      rm -f "$APPLY_APPEARANCE_TARGET" 2>/dev/null || :
    fi
  fi
  rm -rf "$WORK/apply-backup"
  say 'Target apply failed; original configuration restored.' >&2
}
apply_target_release() {
  [ "$1" = 2 ] || die "unsupported apply protocol: $1"
  [ -n "${NIRUX_STAGE_WORK:-}" ] || die 'target apply work directory is missing'
  WORK=$NIRUX_STAGE_WORK
  OS=${NIRUX_APPLY_OS:-$(distro)}
  DM=${NIRUX_APPLY_DM:-keep}
  BROWSER_EFFECTIVE=${NIRUX_APPLY_BROWSER:-keep}
  operation=${NIRUX_APPLY_OPERATION:-update}
  RELEASE=${NIRUX_APPLY_RELEASE:-$(manifest_version suite)}
  [ "$(manifest_version schema)" = 1 ] || die 'unsupported manifest schema'
  [ "$(manifest_version suite)" = "$VERSION" ] || die 'target installer/manifest version mismatch'
  [ "$RELEASE" = "$VERSION" ] || die 'apply release does not match the target installer'
  [ -f "$WORK/generation/manifest" ] || die 'target apply has no staged generation'
  [ "$(awk '$1 == "suite" {print $2}' "$WORK/generation/manifest")" = "$RELEASE" ] || \
    die 'staged generation does not match the apply release'
  # The caller may predate an asset added by this target. The target owns the
  # new asset list and fetches/verifies anything it needs before changing user
  # or system files.
  release_optional_file nirux "$RELEASE" nirux-wallpapers.tar.xz
  release_optional_file nirux "$RELEASE" nirux-terminal.tar.xz
  release_optional_file nirux "$RELEASE" nirux-integration.tar.xz
  apply_prepare_backup
  APPLY_OK=0
  trap 'apply_restore_config' EXIT INT TERM HUP
  browser_install
  install_config
  install_wallpapers
  install_terminal
  prepare_pam
  install_greeters "$DM"
  register_session
  setup_startx
  if [ "$operation" = install ]; then enable_services; fi
  activate
  APPLY_OK=1
  trap - EXIT INT TERM HUP
  rm -rf "$WORK/apply-backup"
  if [ -n "${DISPLAY:-}" ] && "$BIN/niructl" restart-bar; then
    say 'Applied through the target installer. Running bar restarted; log out/in to activate the new WM, idle daemon and session.'
  else say 'Applied through the target installer. Log out/in to activate all updated programs. In a new NIRU session: niructl restart-bar.'
  fi
}
stage_release() {
  if [ -z "$RELEASE" ]; then
    fetch https://api.github.com/repos/nirucon/nirux/releases/latest "$WORK/latest.json"
    RELEASE=$(sed -n 's/.*"tag_name": *"v\([0-9.]*\)".*/\1/p' "$WORK/latest.json" | head -n 1)
  fi
  release_files nirux "$RELEASE" nirux manifest config.example.toml appearance.example.toml
  release_optional_file nirux "$RELEASE" nirux-wallpapers.tar.xz
  release_optional_file nirux "$RELEASE" nirux-terminal.tar.xz
  release_optional_file nirux "$RELEASE" nirux-integration.tar.xz
  [ "$(manifest_version schema)" = 1 ] || die "unsupported manifest schema"
  [ "$(manifest_version suite)" = "$RELEASE" ] || die "suite/manifest version mismatch"
  sh -n "$WORK/download/nirux/nirux"
  reported=$(sh "$WORK/download/nirux/nirux" --version | awk '{print $2}')
  [ "$reported" = "$RELEASE" ] || die 'installer/manifest version mismatch'
  APPLY_PROTOCOL=0
  apply_version=$(sh "$WORK/download/nirux/nirux" _apply-version 2>/dev/null || :)
  if [ "$apply_version" = 2 ]; then APPLY_PROTOCOL=2; fi
  # Packages come from the verified target installer and are provisioned before
  # any staged binary is executed. This lets a new shared-library dependency be
  # present when the new component is first started and version-checked.
  if [ "$packages" = 1 ]; then
    NIRUX_PROVISION_OS=$OS NIRUX_PROVISION_DM=$DM NIRUX_PROVISION_BROWSER=$BROWSER_EFFECTIVE \
      sh "$WORK/download/nirux/nirux" _provision missing
  fi
  # A new target installer stages the release through a versioned handoff, so a
  # newly added component is included on the first update rather than one later.
  handoff=$(sh "$WORK/download/nirux/nirux" _handoff-version 2>/dev/null || :)
  if [ "$handoff" = 1 ]; then
    if ! NIRUX_STAGE_WORK=$WORK NIRUX_PROVISION_OS=$OS \
      sh "$WORK/download/nirux/nirux" _stage 1; then
      die 'target installer staging failed; current installation kept'
    fi
    say 'Staged components through the target installer handoff.'
  else
    stage_components
  fi
  [ -f "$WORK/generation/manifest" ] || die 'target installer produced no staged generation'
  [ "$(awk '$1 == "suite" {print $2}' "$WORK/generation/manifest")" = "$RELEASE" ] || \
    die 'staged generation does not match the requested release'
}
switch_link() {
  ln -s "$2" "$STATE/.$1.$$"
  mv -Tf "$STATE/.$1.$$" "$STATE/$1"
}
sync_front_links() {
  for front in "$BIN"/*; do
    [ -L "$front" ] || continue
    case "$(readlink "$front")" in
      "$STATE/current/bin/"*)
        program=${front##*/}
        [ -e "$STATE/current/bin/$program" ] || rm -f "$front"
        ;;
    esac
  done
}
activate() {
  mkdir -p "$STATE/generations" "$BIN"
  # Adopt a legacy flat installation without changing its active versions.
  if [ ! -L "$STATE/current" ]; then
    legacy=$STATE/generations/legacy-$(date +%s)-$$
    mkdir -p "$legacy/bin"
    for program in $PROGRAMS; do
      [ ! -f "$BIN/$program" ] || cp -pL "$BIN/$program" "$legacy/bin/$program"
    done
    switch_link current "$legacy"
  fi
  old=$(readlink "$STATE/current")
  generation=$STATE/generations/$RELEASE-${WORK##*.}
  mv "$WORK/generation" "$generation"
  # These front links stay constant; current is the single activation point.
  # Use the staged generation rather than this installer's old PROGRAMS list so
  # a component added by the target release is linked on the first update.
  for staged in "$generation/bin"/*; do
    [ -f "$staged" ] || continue
    program=${staged##*/}
    ln -s "$STATE/current/bin/$program" "$BIN/.$program.$$"
    mv -Tf "$BIN/.$program.$$" "$BIN/$program"
  done
  switch_link previous "$old"
  switch_link current "$generation"
  sync_front_links
  say "Activated NIRUX $RELEASE. Previous generation retained for nirux rollback."
}
owned() {
  grep -qxF "# NIRUX owner: $PREFIX" "$1" ||
    grep -qxF "// NIRUX owner: $PREFIX" "$1" ||
    grep -qxF "/* NIRUX owner: $PREFIX */" "$1"
}
legacy_owned() {
  case "$1" in
    */xsessions/niruwm.desktop) grep -qxF "Exec=\"$BIN/niruwm-session\"" "$1" ;;
    */pam.d/nirulock) grep -q '^# Installed by nirux\.' "$1" ;;
    *) return 1 ;;
  esac
}
write_system() {
  target=$1; source=$2
  if [ -f "$target" ]; then
    installed_sum=$(sha256sum "$target" | cut -d ' ' -f1)
    source_sum=$(sha256sum "$source" | cut -d ' ' -f1)
    [ "$installed_sum" != "$source_sum" ] || return 0
  fi
  if [ -f "$target" ] && ! owned "$target" && ! legacy_owned "$target"; then
    if grep -q '^# NIRUX owner:' "$target"; then die "$target belongs to another NIRUX installation"; fi
    [ -f "$target.nirux-backup" ] || as_root cp -p "$target" "$target.nirux-backup"
  fi
  as_root install -d -m 755 "$(dirname "$target")"
  as_root install -m 644 "$source" "$target"
}
prepare_pam() {
  pam_source=$WORK/generation/pam
  for include in $(awk '$2 == "include" || $2 == "substack" {print $3}' "$pam_source"); do
    [ -f "$ROOT/etc/pam.d/$include" ] || die "PAM include $include is missing; install the distribution PAM packages"
  done
  { say "# NIRUX owner: $PREFIX"; cat "$pam_source"; } > "$WORK/pam"
  write_system "$ROOT/etc/pam.d/nirulock" "$WORK/pam"
}
install_greeters() {
  greeter_dm=${1:-keep}
  case "$greeter_dm" in
    keep)
      if [ -f "$ROOT/etc/sddm.conf.d/50-nirux.conf" ] && owned "$ROOT/etc/sddm.conf.d/50-nirux.conf"; then
        greeter_dm=sddm
      elif [ -f "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" ] &&
           owned "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf"; then
        greeter_dm=lightdm
      fi
      ;;
  esac

  archive=$WORK/download/nirux/nirux-integration.tar.xz
  [ -f "$archive" ] || return 0
  unpack=$WORK/integration-unpack
  rm -rf "$unpack"
  mkdir -p "$unpack" || die 'could not create the integration extraction directory'
  tar -xJf "$archive" -C "$unpack" || die 'could not extract the NIRUX integration assets'
  [ -f "$unpack/polkit/49-nirux-power.rules" ] || die 'integration archive is missing the power rule'
  { say "// NIRUX owner: $PREFIX"; cat "$unpack/polkit/49-nirux-power.rules"; } > "$WORK/power.rules"
  # Power actions stay passwordless only for a local, active administrator.
  write_system "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules" "$WORK/power.rules"

  case "$greeter_dm" in
    sddm)
      for file in theme.conf metadata.desktop arrow.png; do
        [ -f "$unpack/sddm/$file" ] || die "integration archive is missing sddm/$file"
        write_system "$ROOT/usr/share/sddm/themes/nirux/$file" "$unpack/sddm/$file"
      done
      [ -f "$unpack/background.png" ] || die 'integration archive is missing background.png'
      write_system "$ROOT/usr/share/sddm/themes/nirux/background.png" "$unpack/background.png"
      [ -f "$unpack/sddm/Main.qml" ] || die 'integration archive is missing sddm/Main.qml'
      { say "// NIRUX owner: $PREFIX"; cat "$unpack/sddm/Main.qml"; } > "$WORK/sddm-Main.qml"
      write_system "$ROOT/usr/share/sddm/themes/nirux/Main.qml" "$WORK/sddm-Main.qml"
      { say "# NIRUX owner: $PREFIX"; say '[Theme]'; say 'Current=nirux'; } > "$WORK/sddm-nirux.conf"
      write_system "$ROOT/etc/sddm.conf.d/50-nirux.conf" "$WORK/sddm-nirux.conf"
      say 'Installed NIRUX SDDM greeter'
      ;;
    lightdm)
      [ -f "$unpack/lightdm/50-nirux.conf" ] || die 'integration archive is missing the LightDM greeter config'
      [ -f "$unpack/gtk/index.theme" ] || die 'integration archive is missing the GTK theme'
      [ -f "$unpack/gtk/gtk-3.0/gtk.css" ] || die 'integration archive is missing the GTK stylesheet'
      as_root install -d -m 755 "$ROOT/usr/share/nirux/greeter"
      write_system "$ROOT/usr/share/nirux/greeter/rooted-in-less.png" "$unpack/background.png"
      { say "# NIRUX owner: $PREFIX"; cat "$unpack/lightdm/50-nirux.conf"; } > "$WORK/lightdm-nirux.conf"
      write_system "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf" \
        "$WORK/lightdm-nirux.conf"
      { say "# NIRUX owner: $PREFIX"; cat "$unpack/gtk/index.theme"; } > "$WORK/gtk-index.theme"
      write_system "$ROOT/usr/share/themes/NIRU/index.theme" "$WORK/gtk-index.theme"
      { say "/* NIRUX owner: $PREFIX */"; cat "$unpack/gtk/gtk-3.0/gtk.css"; } > "$WORK/gtk.css"
      write_system "$ROOT/usr/share/themes/NIRU/gtk-3.0/gtk.css" "$WORK/gtk.css"
      say 'Installed NIRUX LightDM GTK greeter'
      ;;
  esac
  rm -rf "$unpack"
}

remove_greeters() {
  remove_system "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules"
  remove_system "$ROOT/etc/sddm.conf.d/50-nirux.conf"
  if [ -f "$ROOT/usr/share/sddm/themes/nirux/Main.qml" ] &&
     owned "$ROOT/usr/share/sddm/themes/nirux/Main.qml"; then
    as_root rm -rf "$ROOT/usr/share/sddm/themes/nirux"
  fi
  remove_system "$ROOT/usr/share/lightdm/lightdm-gtk-greeter.conf.d/50-nirux.conf"
  if [ -f "$ROOT/usr/share/themes/NIRU/index.theme" ] &&
     owned "$ROOT/usr/share/themes/NIRU/index.theme"; then
    as_root rm -rf "$ROOT/usr/share/themes/NIRU"
  fi
  if [ -f "$ROOT/usr/share/nirux/greeter/rooted-in-less.png" ]; then
    as_root rm -f "$ROOT/usr/share/nirux/greeter/rooted-in-less.png"
    as_root rmdir "$ROOT/usr/share/nirux/greeter" "$ROOT/usr/share/nirux" 2>/dev/null || :
  fi
}

register_session() {
  { say "# NIRUX owner: $PREFIX"; say '[Desktop Entry]'; say 'Name=NIRUWM'; say 'Type=Application'; say "Exec=\"$BIN/niruwm-session\""; say 'DesktopNames=NIRUWM'; } > "$WORK/session.desktop"
  write_system "$ROOT/usr/share/xsessions/niruwm.desktop" "$WORK/session.desktop"
}
setup_startx() {
  # Never replace an existing user's xinitrc, including a symlink. Refresh the
  # NIRUX-owned file so an update keeps the current session path.
  if { [ ! -e "$HOME/.xinitrc" ] && [ ! -L "$HOME/.xinitrc" ]; } ||
     { [ -f "$HOME/.xinitrc" ] && owned "$HOME/.xinitrc"; }; then
    { say '#!/bin/sh'; say "# NIRUX owner: $PREFIX"; say "exec \"$BIN/niruwm-session\""; } > "$WORK/xinitrc"
    install -m 755 "$WORK/xinitrc" "$HOME/.xinitrc"
  fi
  say "From a local TTY: startx $BIN/niruwm-session"
  say "If ~/.xinitrc selects NIRU, plain startx works too. Existing ~/.xinitrc is preserved."
}
enable_services() {
  if [ "$OS" = void ]; then
    for service in dbus elogind; do
      if [ -d "$ROOT/etc/sv/$service" ] && [ ! -e "$ROOT/var/service/$service" ]; then
        as_root ln -s "/etc/sv/$service" "$ROOT/var/service/$service"
      fi
    done
    case "$DM" in sddm|lightdm)
      [ -d "$ROOT/etc/sv/$DM" ] || die "missing runit service for $DM"
      [ -e "$ROOT/var/service/$DM" ] || as_root ln -s "/etc/sv/$DM" "$ROOT/var/service/$DM"
      ;; esac
  else
    case "$DM" in sddm|lightdm) as_root systemctl enable "$DM.service" ;; esac
  fi
}
check_pam() {
  [ -f "$ROOT/etc/pam.d/nirulock" ] || { say 'missing PAM service'; return 1; }
  [ "$(stat -c %a "$ROOT/etc/pam.d/nirulock")" = 644 ] || { say 'incorrect PAM permissions'; return 1; }
  awk '$1 == "auth" {found=1} END {exit !found}' "$ROOT/etc/pam.d/nirulock" || { say 'PAM service has no authentication rules'; return 1; }
  for include in $(awk '$2 == "include" || $2 == "substack" {print $3}' "$ROOT/etc/pam.d/nirulock"); do
    [ -f "$ROOT/etc/pam.d/$include" ] || { say "missing PAM include: $include"; return 1; }
  done
}
browser_status() {
  policy=$(browser_policy)
  case "$policy" in
    none)
      say 'managed browser: Helium disabled by persistent opt-out'
      return 0
      ;;
    helium)
      browser=$(browser_path || :)
      if [ -z "$browser" ] || [ ! -x "$browser" ]; then
        say 'missing managed browser helium'
        return 1
      fi
      browser_version=$("$browser" --version 2>&1) || {
        say "broken managed browser helium: $browser_version"
        return 1
      }
      say "installed managed browser $browser_version"
      if browser_managed; then
        desktop=$(browser_desktop_file)
        if [ -f "$desktop" ] && grep -qF "Exec=\"$BIN/helium\"" "$desktop"; then
          say 'installed Helium desktop entry'
        else
          say 'missing or different Helium desktop entry'
          return 1
        fi
      fi
      return 0
      ;;
  esac
  return 0
}
status() {
  result=0
  say "NIRUX $VERSION ($PREFIX)"
  for program in $PROGRAMS; do
    if [ ! -x "$BIN/$program" ]; then say "missing $program"; result=1; continue; fi
    case "$program" in
      niructl|niruwm-session) say "installed $program" ;;
      *)
        if version_text=$("$BIN/$program" --version 2>&1); then say "installed $version_text"
        else say "broken $program: $version_text"; result=1
        fi ;;
    esac
  done
  if [ -f "$ROOT/usr/share/xsessions/niruwm.desktop" ] && grep -qF "$BIN/niruwm-session" "$ROOT/usr/share/xsessions/niruwm.desktop"; then
    say 'installed display-manager session'
  else say 'missing or different display-manager session'; result=1
  fi
  if check_pam; then say 'PAM includes and permissions OK (password authentication not exercised)'; else result=1; fi
  if [ -f "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules" ] &&
     owned "$ROOT/etc/polkit-1/rules.d/49-nirux-power.rules"; then
    say 'installed local power polkit rule'
  else say 'missing local power polkit rule'; result=1; fi
  browser_status || result=1
  if [ -L "$STATE/current" ]; then say "generation: $(readlink "$STATE/current")"; fi
  if [ -x "$HOME/.local/bin/nirupi-session" ] || [ -f "$ROOT/usr/share/xsessions/nirupi-dwm.desktop" ]; then say 'NIRUPI present (separate session)'; fi
  return "$result"
}
# The programs the user actually selected in the shared configuration.
configured_commands() {
  [ -x "$BIN/niruwm" ] || return 0
  "$BIN/niruwm" --dump-config 2>/dev/null | awk '
    /^(terminal|browser|launcher) = / {
      line = $0
      sub(/^[^=]*= */, "", line)
      gsub(/[]["]/, "", line)
      split(line, items, ",")
      split(items[1], words, " ")
      if (words[1] != "") print words[1]
    }
  ' | sort -u
}

doctor() {
  result=0
  status || result=1
  say "selected prefix: $PREFIX"
  case ":$PATH:" in
    *":$BIN:"*) say "PATH includes selected prefix" ;;
    *) say "PATH does not include selected prefix (the session prepends it)" ;;
  esac
  for tool in startx Xorg xauth dbus-run-session fc-match fish brightnessctl gammastep notify-send; do
    if command -v "$tool" >/dev/null 2>&1; then say "available $tool"; else say "missing $tool"; result=1; fi
  done
  if [ -d /sys/class/backlight ] && [ -n "$(ls -A /sys/class/backlight 2>/dev/null)" ]; then
    if command -v brightnessctl >/dev/null 2>&1 && brightnessctl -m >/dev/null 2>&1; then
      say 'backlight readable through brightnessctl'
    else
      say 'backlight present but brightnessctl cannot read it (check udev/group permissions)'
      result=1
    fi
  else say 'no backlight device (desktop or external display)'
  fi
  for tool in $(configured_commands); do
    if command -v "$tool" >/dev/null 2>&1 || [ -x "$BIN/$tool" ]; then
      say "available configured $tool"
    else
      say "missing configured $tool (selected in config.toml)"
      result=1
    fi
  done
  for tool in dunst picom feh maim playerctl wpctl amixer; do
    if command -v "$tool" >/dev/null 2>&1; then say "available optional $tool"; else say "missing optional $tool"; fi
  done
  if [ -n "${DISPLAY:-}" ] && command -v wpctl >/dev/null 2>&1; then
    if wpctl status 2>/dev/null | awk '/Sinks:/{inside=1;next} /Sources:/{inside=0} inside && /\*/{found=1} END{exit !found}'; then
      say 'audio default sink available'
    else
      say 'no default audio sink (PipeWire/WirePlumber)'; result=1
    fi
  fi
  for pair in 'niruwm --check-config' 'nirubar --check-config' 'niruidle --config' 'niruscreensaver --config' 'nirulock --config' 'nirulauncher --check-config' 'nirunotify --check-config'; do
    set -- $pair
    say "== $pair"
    if [ -x "$BIN/$1" ]; then "$BIN/$1" "$2" || result=1; else result=1; fi
  done
  if [ -n "${DISPLAY:-}" ]; then
    say '== live X session'
    "$BIN/niructl" status || result=1
    for program in niruwm nirubar; do
      if pgrep -u "$(id -u)" -x "$program" >/dev/null; then say "running $program"; else say "not running $program"; result=1; fi
    done
    if command -v xprop >/dev/null 2>&1; then
      wm_id=$(xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | sed -n 's/.*# //p')
      if [ -n "$wm_id" ]; then
        wm_name=$(xprop -id "$wm_id" _NET_WM_NAME 2>/dev/null | sed -n 's/.*= //p')
        say "X WM owner $wm_id ${wm_name:-}"
      else
        say "no X window manager owns _NET_SUPPORTING_WM_CHECK"; result=1
      fi
    fi
    if command -v xwininfo >/dev/null 2>&1; then
      bars=$(xwininfo -root -tree 2>/dev/null | grep -c 'NIRUBAR' || true)
      layouts=$(xprop -root _NIRUWM_MONITORS 2>/dev/null | grep -o '\\n' | wc -l | tr -d ' ')
      say "bar windows: $bars; monitor layouts published: $layouts"
      if [ "$bars" != "$layouts" ]; then say 'bar ownership does not match the published monitors'; result=1; fi
    fi
    if command -v dbus-send >/dev/null 2>&1; then
      owner=$(dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus.GetNameOwner string:org.freedesktop.Notifications 2>/dev/null | sed -n 's/.*string "\(.*\)"/\1/p' | head -n1)
      if [ -n "$owner" ]; then say "notifications owned by $owner"; else say 'no notification daemon owns the session bus'; fi
    fi
    if pgrep -u "$(id -u)" -x gammastep >/dev/null; then say 'night-light provider gammastep is running'; else say 'night-light provider gammastep is not running'; fi
    if pgrep -u "$(id -u)" -x niruidle >/dev/null; then say 'idle provider niruidle is running'; else say 'idle provider niruidle is not running'; fi
  else say 'Live session check skipped: DISPLAY is unset (normal over SSH/TTY).'
  fi
  return "$result"
}
remove_system() {
  if [ -f "$1" ] && owned "$1"; then
    if [ -f "$1.nirux-backup" ]; then as_root mv -f "$1.nirux-backup" "$1"
    else as_root rm -f "$1"
    fi
  fi
}
uninstall() {
  purge=0
  for option in "$@"; do case "$option" in --purge) purge=1 ;; *) die "unknown option: $option" ;; esac; done
  lock
  remove_system "$ROOT/usr/share/xsessions/niruwm.desktop"
  remove_system "$ROOT/etc/pam.d/nirulock"
  remove_greeters
  for program in $PROGRAMS; do
    if [ -L "$BIN/$program" ] && [ "$(readlink "$BIN/$program")" = "$STATE/current/bin/$program" ]; then rm -f "$BIN/$program"; fi
  done
  if [ -f "$HOME/.xinitrc" ] && owned "$HOME/.xinitrc"; then rm -f "$HOME/.xinitrc"; fi
  browser_remove_managed
  browser_remove_policy
  remove_terminal
  if [ "$purge" = 1 ]; then
    remove_owned_wallpapers
    rm -rf "${XDG_CONFIG_HOME:-$HOME/.config}/niruwm" "${XDG_CONFIG_HOME:-$HOME/.config}/niruui" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/nirubar" "${XDG_CONFIG_HOME:-$HOME/.config}/nirulauncher" \
      "${XDG_CONFIG_HOME:-$HOME/.config}/nirunotify" \
      "${XDG_STATE_HOME:-$HOME/.local/state}/niruwm" "${XDG_STATE_HOME:-$HOME/.local/state}/nirulock" \
      "${XDG_STATE_HOME:-$HOME/.local/state}/niruscreensaver" \
      "${XDG_CACHE_HOME:-$HOME/.cache}/nirubar"
  fi
  rm -rf "$STATE/generations"
  rm -f "$STATE/current" "$STATE/previous"
  say 'NIRU removed. OS packages and NIRUPI retained. An already running session exits normally on logout.'
}
rollback() {
  lock
  [ -L "$STATE/previous" ] || die 'no previous generation'
  previous=$(readlink "$STATE/previous")
  [ -x "$previous/bin/niruwm" ] || die 'previous generation is incomplete'
  current=$(readlink "$STATE/current")
  switch_link current "$previous"
  switch_link previous "$current"
  sync_front_links
  say 'Previous program generation restored. System packages and PAM configuration are not rolled back.'
  say 'Log out and back in to use the restored WM and session.'
}
install_or_update() {
  operation=$1; shift
  packages=1; DM=auto; RELEASE=${NIRUX_RELEASE:-}
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --minimal|--no-packages) packages=0 ;;
      --full) packages=1 ;;
      --display-manager) shift; [ "$#" -gt 0 ] || die 'missing display-manager value'; DM=$1 ;;
      --browser) shift; [ "$#" -gt 0 ] || die 'missing browser value'; BROWSER_CHOICE=$1; BROWSER_EXPLICIT=1 ;;
      --release) shift; [ "$#" -gt 0 ] || die 'missing release version'; RELEASE=${1#v} ;;
      *) die "unknown option: $1" ;;
    esac
    shift
  done
  OS=$(distro)
  platform
  if [ "$operation" = install ]; then choose_dm; else DM=keep; fi
  choose_browser "$operation"
  lock
  case "$BROWSER_EFFECTIVE" in
    helium|none)
      if [ "$operation" = install ] || [ "$BROWSER_EXPLICIT" = 1 ]; then
        browser_policy_set "$BROWSER_EFFECTIVE"
      fi
      ;;
  esac
  if [ "$BROWSER_EXPLICIT" = 1 ] && [ "$BROWSER_EFFECTIVE" = none ]; then
    browser_remove_managed
  fi
  # The bootstrap install has to include curl before any release can be
  # downloaded. Updates skip this and let the newly verified release provision
  # its own package list below.
  if [ "$operation" = install ] && [ "$packages" = 1 ]; then install_packages; fi
  stage_release
  if [ "$APPLY_PROTOCOL" = 2 ]; then
    if ! NIRUX_PREFIX=$PREFIX NIRUX_SYSTEM_ROOT=$ROOT NIRUX_STAGE_WORK=$WORK \
      NIRUX_APPLY_RELEASE=$RELEASE NIRUX_APPLY_OS=$OS \
      NIRUX_APPLY_DM=$DM NIRUX_APPLY_BROWSER=$BROWSER_EFFECTIVE \
      NIRUX_APPLY_OPERATION=$operation \
      sh "$WORK/download/nirux/nirux" _apply 2; then
      die 'target installer apply failed; current installation kept'
    fi
    return 0
  fi
  browser_install
  # Configuration and system integration must succeed before switching the
  # active programs. A rejected configuration leaves the old generation intact.
  install_config
  install_wallpapers
  install_terminal
  prepare_pam
  install_greeters "$DM"
  register_session
  setup_startx
  if [ "$operation" = install ]; then enable_services; fi
  activate
  if [ -n "${DISPLAY:-}" ] && "$BIN/niructl" restart-bar; then
    say 'Running bar restarted. Log out/in to activate the new WM, idle daemon and session.'
  else say 'Log out/in to activate all updated programs. In a new NIRU session: niructl restart-bar.'
  fi
}
main() {
  case "${1:-}" in
    install|update) install_or_update "$@" ;;
    _provision) shift; provision_packages "$@" ;;
    _handoff-version) say 1 ;;
    _apply-version) say 2 ;;
    _apply) shift; [ "$#" = 1 ] || die 'apply takes one protocol version'; apply_target_release "$1" ;;
    _stage) shift; [ "$#" = 1 ] || die 'staging takes one protocol version'; stage_target_release "$1" ;;
    uninstall) shift; uninstall "$@" ;;
    rollback) [ "$#" = 1 ] || die 'rollback takes no arguments'; rollback ;;
    status|doctor) [ "$#" = 1 ] || die "$1 takes no arguments"; "$1" ;;
    --version) say "NIRUX $VERSION" ;;
    --help|help) usage ;;
    '') usage; exit 2 ;;
    *) die "unknown command: $1" ;;
  esac
}
[ "${NIRUX_LIBRARY:-0}" = 1 ] || main "$@"
